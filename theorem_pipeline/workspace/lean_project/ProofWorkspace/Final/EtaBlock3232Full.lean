theorem sourceEtaBatch3232_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch3232Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (3232+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (3232+k))) := by
