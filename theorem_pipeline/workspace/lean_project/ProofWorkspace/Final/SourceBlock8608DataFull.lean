theorem sourceBlock8608PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8608+k), retainedPiUpper (8608+k)) =
      sourceBlock8608PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8608, retainedPiUpper 8608) =
      sourceBlock8608PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8607, retainedPiUpper 8607) :=
      retainedPiPair_succ 8607
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8576PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8576PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8608PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8608PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8608PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8608 32 sourceBlock8608PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

