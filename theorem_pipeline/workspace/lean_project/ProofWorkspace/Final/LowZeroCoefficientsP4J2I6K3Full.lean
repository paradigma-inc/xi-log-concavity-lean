  have hs : ‖ratComplexValue (lowZeroCoefficientsP4J2I6K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J2I6K3Point)
        (Real.pi*(3:ℝ)^2) (((29:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J2I6K3State 0):ℝ) := lowZeroCoefficientsP4J2I6K3_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP4J2I6K3Point
    ((29:ℚ)/4) ((1:ℚ)/4) 3 lowZeroCoefficientsP4J2I6K3State lowZeroCoefficientsP4J2I6K3Radius
