theorem sourceBlock9984PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (9984+k), retainedPiUpper (9984+k)) =
      sourceBlock9984PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 9984, retainedPiUpper 9984) =
      sourceBlock9984PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 9983, retainedPiUpper 9983) :=
      retainedPiPair_succ 9983
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock9952PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock9952PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock9984PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock9984PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock9984PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 9984 32 sourceBlock9984PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

