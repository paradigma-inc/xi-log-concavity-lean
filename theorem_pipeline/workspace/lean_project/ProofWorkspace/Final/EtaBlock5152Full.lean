theorem sourceEtaBatch5152_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates5152 =
      (sourceEtaBatch5152Pairs, sourceEtaRootStates5184) := by
  decide +kernel

theorem sourceEtaRootStates5184_eq : sourceEtaRootStates5184 = etaRootStateTable 400 5184 := by
  have h := congrArg Prod.snd sourceEtaBatch5152_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates5152_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch5152_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch5152Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (5152+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (5152+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch5152_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates5152_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 5152)).1 =
    sourceEtaBatch5152Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 5152 32 k hk

def sourceEtaBatch5152Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch5152Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch5152Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch5152Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch5152_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch5152Lower k:ℝ) ≤ etaIntegral (xiGridArgument (5152+k):ℝ) ∧
      etaIntegral (xiGridArgument (5152+k):ℝ) ≤ (sourceEtaBatch5152Upper k:ℝ) := by
  unfold sourceEtaBatch5152Lower sourceEtaBatch5152Upper
  rw [sourceEtaBatch5152_entry k hk]
  exact ratEtaStream_retained_enclosure (5152+k)

theorem sourceEtaBatch5152_width : ∀ k : Fin 32,
    sourceEtaBatch5152Upper k - sourceEtaBatch5152Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

