theorem sourceBlock8576PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8576+k), retainedPiUpper (8576+k)) =
      sourceBlock8576PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8576, retainedPiUpper 8576) =
      sourceBlock8576PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8575, retainedPiUpper 8575) :=
      retainedPiPair_succ 8575
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8544PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8544PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8576PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8576PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8576PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8576 32 sourceBlock8576PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

