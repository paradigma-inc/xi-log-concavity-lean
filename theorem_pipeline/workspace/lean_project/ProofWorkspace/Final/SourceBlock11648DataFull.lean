theorem sourceBlock11648PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (11648+k), retainedPiUpper (11648+k)) =
      sourceBlock11648PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 11648, retainedPiUpper 11648) =
      sourceBlock11648PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 11647, retainedPiUpper 11647) :=
      retainedPiPair_succ 11647
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11616PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11616PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11648PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11648PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11648PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11648 32 sourceBlock11648PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

