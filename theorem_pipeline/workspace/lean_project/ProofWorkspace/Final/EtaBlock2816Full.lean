theorem sourceEtaBatch2816_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates2816 =
      (sourceEtaBatch2816Pairs, sourceEtaRootStates2848) := by
  decide +kernel

theorem sourceEtaRootStates2848_eq : sourceEtaRootStates2848 = etaRootStateTable 400 2848 := by
  have h := congrArg Prod.snd sourceEtaBatch2816_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates2816_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch2816_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch2816Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (2816+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (2816+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch2816_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates2816_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 2816)).1 =
    sourceEtaBatch2816Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 2816 32 k hk

def sourceEtaBatch2816Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch2816Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch2816Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch2816Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch2816_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch2816Lower k:ℝ) ≤ etaIntegral (xiGridArgument (2816+k):ℝ) ∧
      etaIntegral (xiGridArgument (2816+k):ℝ) ≤ (sourceEtaBatch2816Upper k:ℝ) := by
  unfold sourceEtaBatch2816Lower sourceEtaBatch2816Upper
  rw [sourceEtaBatch2816_entry k hk]
  exact ratEtaStream_retained_enclosure (2816+k)

theorem sourceEtaBatch2816_width : ∀ k : Fin 32,
    sourceEtaBatch2816Upper k - sourceEtaBatch2816Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

