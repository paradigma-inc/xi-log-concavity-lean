theorem lowZeroCoefficientsP2J3I7K2_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP2J3I7K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J3I7K2Point)
        (Real.pi*(2:ℝ)^2) (((31:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J3I7K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP2J3I7K2_seed_eq]
  have he := lowZeroSeedP2J3I7K2_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP2J3I7K2State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

