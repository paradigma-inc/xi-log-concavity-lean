theorem lowZeroCoefficientsP2J3I7K2_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP2J3I7K2Point ((31:ℚ)/2) ((1:ℚ)/2)
      sourcePiMidpoint 2 lowZeroCoefficientsP2J3I7K2State lowZeroCoefficientsP2J3I7K2Radius := by
