    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11744 32 sourceBlock11744PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

