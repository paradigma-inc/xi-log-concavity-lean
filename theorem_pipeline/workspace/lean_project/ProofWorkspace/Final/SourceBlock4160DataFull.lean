theorem sourceBlock4160PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (4160+k), retainedPiUpper (4160+k)) =
      sourceBlock4160PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 4160, retainedPiUpper 4160) =
      sourceBlock4160PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 4159, retainedPiUpper 4159) :=
      retainedPiPair_succ 4159
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4128PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4128PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock4160PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock4160PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4160PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 4160 32 sourceBlock4160PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

