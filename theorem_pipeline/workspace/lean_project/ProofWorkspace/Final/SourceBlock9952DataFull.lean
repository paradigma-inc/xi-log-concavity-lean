    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 9952 32 sourceBlock9952PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

