theorem sourceBlock12992PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12992+k), retainedPiUpper (12992+k)) =
      sourceBlock12992PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12992, retainedPiUpper 12992) =
      sourceBlock12992PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12991, retainedPiUpper 12991) :=
      retainedPiPair_succ 12991
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12960PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12960PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12992PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12992PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12992PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12992 32 sourceBlock12992PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

