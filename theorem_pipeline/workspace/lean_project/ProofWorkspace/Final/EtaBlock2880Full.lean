  ratRoundUpper (((sourceEtaBatch2880Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch2880_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch2880Lower k:ℝ) ≤ etaIntegral (xiGridArgument (2880+k):ℝ) ∧
      etaIntegral (xiGridArgument (2880+k):ℝ) ≤ (sourceEtaBatch2880Upper k:ℝ) := by
  unfold sourceEtaBatch2880Lower sourceEtaBatch2880Upper
  rw [sourceEtaBatch2880_entry k hk]
  exact ratEtaStream_retained_enclosure (2880+k)

theorem sourceEtaBatch2880_width : ∀ k : Fin 32,
    sourceEtaBatch2880Upper k - sourceEtaBatch2880Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
