theorem sourceBlock10592PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10592+k), retainedPiUpper (10592+k)) =
      sourceBlock10592PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10592, retainedPiUpper 10592) =
      sourceBlock10592PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10591, retainedPiUpper 10591) :=
      retainedPiPair_succ 10591
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10560PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10560PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10592PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10592PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10592PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10592 32 sourceBlock10592PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

