theorem sourceBlock9600PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (9600+k), retainedPiUpper (9600+k)) =
      sourceBlock9600PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 9600, retainedPiUpper 9600) =
      sourceBlock9600PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 9599, retainedPiUpper 9599) :=
      retainedPiPair_succ 9599
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock9568PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock9568PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock9600PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock9600PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock9600PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 9600 32 sourceBlock9600PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

