theorem sourceBlock8192PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8192+k), retainedPiUpper (8192+k)) =
      sourceBlock8192PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8192, retainedPiUpper 8192) =
      sourceBlock8192PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8191, retainedPiUpper 8191) :=
      retainedPiPair_succ 8191
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8160PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8160PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8192PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8192PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8192PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8192 32 sourceBlock8192PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock8192TwoPairs_eq : ∀ k : Fin 32,
