      sourceBlock8192TwoPairs.getD k (0,0) := by
  have hfirst : (retainedTwoLower 8192, retainedTwoUpper 8192) =
      sourceBlock8192TwoPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)
        (retainedTwoLower 8191, retainedTwoUpper 8191) :=
      retainedTwoPair_succ 8191
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock8160TwoPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) (sourceBlock8160TwoPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8192TwoPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8192TwoPairs.getD (k+1) (0,0) =
        sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock8192TwoPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedTwoLower j, retainedTwoUpper j))
    (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) retainedTwoPair_succ 8192 32 sourceBlock8192TwoPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock8192Midpoints_slice_checked :
    sourceBlock8192Midpoints = (sourceMidpointArray.toList.drop 8192).take 32 := by
  decide +kernel

theorem sourceBlock8192Midpoints_eq_array : ∀ k : Fin 32,
    sourceBlock8192Midpoints.getD k 0 = sourceRoundedMidpoint (8192+k) := by
  intro k
  exact sourceMidpointSlice_lookup 8192 32 sourceBlock8192Midpoints
    sourceBlock8192Midpoints_slice_checked k k.isLt

