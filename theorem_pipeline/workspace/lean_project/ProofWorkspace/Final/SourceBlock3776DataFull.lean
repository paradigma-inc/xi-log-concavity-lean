    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 3776 32 sourceBlock3776PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

