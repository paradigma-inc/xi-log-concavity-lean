    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3744PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock3744PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock3776PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock3776PiPairs.getD (k+1) (0,0) =
