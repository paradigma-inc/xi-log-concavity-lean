theorem sourceBlock10432PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10432+k), retainedPiUpper (10432+k)) =
      sourceBlock10432PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10432, retainedPiUpper 10432) =
      sourceBlock10432PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10431, retainedPiUpper 10431) :=
      retainedPiPair_succ 10431
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10400PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10400PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10432PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10432PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10432PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10432 32 sourceBlock10432PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

