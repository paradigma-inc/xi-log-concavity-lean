      intro k hk n hn
      convert hw k n hk hn using 1 <;> norm_num [theta48PanelHalfWidth])
  convert he using 1 <;> norm_num [thetaExpPanel1_3Value,theta48PanelHalfWidth]

end ReciprocalXi
