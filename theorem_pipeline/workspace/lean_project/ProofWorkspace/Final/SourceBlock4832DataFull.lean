theorem sourceBlock4832PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (4832+k), retainedPiUpper (4832+k)) =
      sourceBlock4832PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 4832, retainedPiUpper 4832) =
      sourceBlock4832PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 4831, retainedPiUpper 4831) :=
      retainedPiPair_succ 4831
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4800PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4800PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock4832PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock4832PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4832PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 4832 32 sourceBlock4832PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

