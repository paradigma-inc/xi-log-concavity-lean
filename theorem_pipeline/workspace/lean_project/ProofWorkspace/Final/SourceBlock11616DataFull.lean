theorem sourceBlock11616PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (11616+k), retainedPiUpper (11616+k)) =
      sourceBlock11616PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 11616, retainedPiUpper 11616) =
      sourceBlock11616PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 11615, retainedPiUpper 11615) :=
      retainedPiPair_succ 11615
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11584PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11584PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11616PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11616PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11616PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11616 32 sourceBlock11616PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

