    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 608 32 sourceBlock608PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

