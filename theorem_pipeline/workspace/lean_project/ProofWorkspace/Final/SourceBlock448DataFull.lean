theorem sourceBlock448PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (448+k), retainedPiUpper (448+k)) =
      sourceBlock448PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 448, retainedPiUpper 448) =
      sourceBlock448PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 447, retainedPiUpper 447) :=
      retainedPiPair_succ 447
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock416PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock416PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock448PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock448PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock448PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 448 32 sourceBlock448PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

