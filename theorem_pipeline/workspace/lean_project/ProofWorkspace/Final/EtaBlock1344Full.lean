    (sourceEtaBatch1344Lower k:ℝ) ≤ etaIntegral (xiGridArgument (1344+k):ℝ) ∧
      etaIntegral (xiGridArgument (1344+k):ℝ) ≤ (sourceEtaBatch1344Upper k:ℝ) := by
  unfold sourceEtaBatch1344Lower sourceEtaBatch1344Upper
  rw [sourceEtaBatch1344_entry k hk]
  exact ratEtaStream_retained_enclosure (1344+k)

theorem sourceEtaBatch1344_width : ∀ k : Fin 32,
    sourceEtaBatch1344Upper k - sourceEtaBatch1344Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
