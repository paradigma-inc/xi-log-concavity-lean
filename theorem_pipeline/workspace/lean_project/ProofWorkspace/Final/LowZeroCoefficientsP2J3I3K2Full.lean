def lowZeroCoefficientsP2J3I3K2State (n : ℕ) : ℚ × ℚ := lowZeroCoefficientsP2J3I3K2States.getD n (0,0)
def lowZeroCoefficientsP2J3I3K2Radius (n : ℕ) : ℚ := lowZeroCoefficientsP2J3I3K2Radii.getD n 0

theorem lowZeroCoefficientsP2J3I3K2_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP2J3I3K2Point ((23:ℚ)/2) ((1:ℚ)/2)
      sourcePiMidpoint 2 lowZeroCoefficientsP2J3I3K2State lowZeroCoefficientsP2J3I3K2Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP2J3I3K2_seed_eq : lowZeroCoefficientsP2J3I3K2State 0=lowZeroSeedP2J3I3K2State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP2J3I3K2_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP2J3I3K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J3I3K2Point)
        (Real.pi*(2:ℝ)^2) (((23:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J3I3K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP2J3I3K2_seed_eq]
  have he := lowZeroSeedP2J3I3K2_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP2J3I3K2State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP2J3I3K2_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP2J3I3K2State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP2J3I3K2Point)
          (theta48PanelCenter 3 3:ℂ) (Real.pi*(2:ℝ)^2)
          (theta48PanelHalfWidth 3) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP2J3I3K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J3I3K2Point)
        (Real.pi*(2:ℝ)^2) (((23:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J3I3K2State 0):ℝ) := lowZeroCoefficientsP2J3I3K2_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP2J3I3K2Point
    ((23:ℚ)/2) ((1:ℚ)/2) 2 lowZeroCoefficientsP2J3I3K2State lowZeroCoefficientsP2J3I3K2Radius
    lowZeroCoefficientsP2J3I3K2_valid (by convert hs using 1 <;> norm_num)
  convert he using 1 <;> norm_num [theta48PanelCenter,theta48PanelHalfWidth]

