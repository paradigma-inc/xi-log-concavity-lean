    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10495, retainedPiUpper 10495) :=
      retainedPiPair_succ 10495
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10464PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10464PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10496PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10496PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10496PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10496 32 sourceBlock10496PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

