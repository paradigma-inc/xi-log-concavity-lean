      sourceBlock13504PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 13504, retainedPiUpper 13504) =
      sourceBlock13504PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 13503, retainedPiUpper 13503) :=
      retainedPiPair_succ 13503
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13472PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock13472PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock13504PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock13504PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13504PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 13504 32 sourceBlock13504PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

