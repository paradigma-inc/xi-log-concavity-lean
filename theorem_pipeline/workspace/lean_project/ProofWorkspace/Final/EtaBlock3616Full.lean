  ratRoundUpper (((sourceEtaBatch3616Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch3616_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch3616Lower k:ℝ) ≤ etaIntegral (xiGridArgument (3616+k):ℝ) ∧
      etaIntegral (xiGridArgument (3616+k):ℝ) ≤ (sourceEtaBatch3616Upper k:ℝ) := by
  unfold sourceEtaBatch3616Lower sourceEtaBatch3616Upper
  rw [sourceEtaBatch3616_entry k hk]
  exact ratEtaStream_retained_enclosure (3616+k)

theorem sourceEtaBatch3616_width : ∀ k : Fin 32,
    sourceEtaBatch3616Upper k - sourceEtaBatch3616Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
