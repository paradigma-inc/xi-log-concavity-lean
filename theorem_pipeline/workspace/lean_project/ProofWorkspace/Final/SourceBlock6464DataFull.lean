theorem sourceBlock6464PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (6464+k), retainedPiUpper (6464+k)) =
      sourceBlock6464PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 6464, retainedPiUpper 6464) =
      sourceBlock6464PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 6463, retainedPiUpper 6463) :=
      retainedPiPair_succ 6463
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6432PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock6432PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock6464PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock6464PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6464PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 6464 32 sourceBlock6464PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

