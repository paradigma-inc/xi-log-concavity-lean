    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12671, retainedPiUpper 12671) :=
      retainedPiPair_succ 12671
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12640PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12640PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12672PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12672PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12672PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12672 32 sourceBlock12672PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

