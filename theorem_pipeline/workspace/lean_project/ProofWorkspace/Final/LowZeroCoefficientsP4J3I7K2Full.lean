def lowZeroCoefficientsP4J3I7K2State (n : ℕ) : ℚ × ℚ := lowZeroCoefficientsP4J3I7K2States.getD n (0,0)
def lowZeroCoefficientsP4J3I7K2Radius (n : ℕ) : ℚ := lowZeroCoefficientsP4J3I7K2Radii.getD n 0

theorem lowZeroCoefficientsP4J3I7K2_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP4J3I7K2Point ((31:ℚ)/2) ((1:ℚ)/2)
      sourcePiMidpoint 2 lowZeroCoefficientsP4J3I7K2State lowZeroCoefficientsP4J3I7K2Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP4J3I7K2_seed_eq : lowZeroCoefficientsP4J3I7K2State 0=lowZeroSeedP4J3I7K2State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP4J3I7K2_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP4J3I7K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J3I7K2Point)
        (Real.pi*(2:ℝ)^2) (((31:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J3I7K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP4J3I7K2_seed_eq]
  have he := lowZeroSeedP4J3I7K2_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP4J3I7K2State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP4J3I7K2_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP4J3I7K2State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP4J3I7K2Point)
          (theta48PanelCenter 3 7:ℂ) (Real.pi*(2:ℝ)^2)
          (theta48PanelHalfWidth 3) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP4J3I7K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J3I7K2Point)
        (Real.pi*(2:ℝ)^2) (((31:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J3I7K2State 0):ℝ) := lowZeroCoefficientsP4J3I7K2_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP4J3I7K2Point
    ((31:ℚ)/2) ((1:ℚ)/2) 2 lowZeroCoefficientsP4J3I7K2State lowZeroCoefficientsP4J3I7K2Radius
    lowZeroCoefficientsP4J3I7K2_valid (by convert hs using 1 <;> norm_num)
