theorem sourceBlock8640PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8640+k), retainedPiUpper (8640+k)) =
      sourceBlock8640PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8640, retainedPiUpper 8640) =
      sourceBlock8640PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8639, retainedPiUpper 8639) :=
      retainedPiPair_succ 8639
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8608PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8608PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8640PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8640PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8640PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8640 32 sourceBlock8640PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

