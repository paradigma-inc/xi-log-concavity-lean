theorem sourceBlock5152PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (5152+k), retainedPiUpper (5152+k)) =
      sourceBlock5152PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 5152, retainedPiUpper 5152) =
      sourceBlock5152PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 5151, retainedPiUpper 5151) :=
      retainedPiPair_succ 5151
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock5120PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock5120PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock5152PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock5152PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock5152PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 5152 32 sourceBlock5152PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

