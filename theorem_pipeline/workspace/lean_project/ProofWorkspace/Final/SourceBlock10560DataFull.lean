    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10528PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10528PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10560PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10560PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10560PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10560 32 sourceBlock10560PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

