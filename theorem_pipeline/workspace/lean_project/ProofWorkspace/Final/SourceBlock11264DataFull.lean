      sourceBlock11264PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 11263, retainedPiUpper 11263) :=
      retainedPiPair_succ 11263
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11232PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11232PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11264PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11264PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11264PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11264 32 sourceBlock11264PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

