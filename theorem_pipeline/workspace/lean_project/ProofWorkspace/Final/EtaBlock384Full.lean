theorem sourceEtaBatch384_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates384 =
      (sourceEtaBatch384Pairs, sourceEtaRootStates416) := by
  decide +kernel

theorem sourceEtaRootStates416_eq : sourceEtaRootStates416 = etaRootStateTable 400 416 := by
  have h := congrArg Prod.snd sourceEtaBatch384_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates384_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch384_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch384Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (384+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (384+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch384_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates384_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 384)).1 =
    sourceEtaBatch384Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 384 32 k hk

def sourceEtaBatch384Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch384Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch384Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch384Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch384_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch384Lower k:ℝ) ≤ etaIntegral (xiGridArgument (384+k):ℝ) ∧
      etaIntegral (xiGridArgument (384+k):ℝ) ≤ (sourceEtaBatch384Upper k:ℝ) := by
  unfold sourceEtaBatch384Lower sourceEtaBatch384Upper
  rw [sourceEtaBatch384_entry k hk]
  exact ratEtaStream_retained_enclosure (384+k)

theorem sourceEtaBatch384_width : ∀ k : Fin 32,
    sourceEtaBatch384Upper k - sourceEtaBatch384Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

