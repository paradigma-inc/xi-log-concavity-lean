theorem sourceBlock12192PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12192+k), retainedPiUpper (12192+k)) =
      sourceBlock12192PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12192, retainedPiUpper 12192) =
      sourceBlock12192PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12191, retainedPiUpper 12191) :=
      retainedPiPair_succ 12191
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12160PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12160PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12192PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12192PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12192PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12192 32 sourceBlock12192PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12192TwoPairs_eq : ∀ k : Fin 32,
    (retainedTwoLower (12192+k), retainedTwoUpper (12192+k)) =
      sourceBlock12192TwoPairs.getD k (0,0) := by
  have hfirst : (retainedTwoLower 12192, retainedTwoUpper 12192) =
      sourceBlock12192TwoPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)
        (retainedTwoLower 12191, retainedTwoUpper 12191) :=
      retainedTwoPair_succ 12191
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12160TwoPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) (sourceBlock12160TwoPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12192TwoPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12192TwoPairs.getD (k+1) (0,0) =
        sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12192TwoPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedTwoLower j, retainedTwoUpper j))
    (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) retainedTwoPair_succ 12192 32 sourceBlock12192TwoPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12192Midpoints_slice_checked :
    sourceBlock12192Midpoints = (sourceMidpointArray.toList.drop 12192).take 32 := by
  decide +kernel

theorem sourceBlock12192Midpoints_eq_array : ∀ k : Fin 32,
    sourceBlock12192Midpoints.getD k 0 = sourceRoundedMidpoint (12192+k) := by
  intro k
  exact sourceMidpointSlice_lookup 12192 32 sourceBlock12192Midpoints
    sourceBlock12192Midpoints_slice_checked k k.isLt

