    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10271, retainedPiUpper 10271) :=
      retainedPiPair_succ 10271
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10240PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10240PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10272PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10272PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10272PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10272 32 sourceBlock10272PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

