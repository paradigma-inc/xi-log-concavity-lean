    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock5088PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock5088PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock5120PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock5120PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock5120PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 5120 32 sourceBlock5120PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

