theorem sourceBlock11200PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (11200+k), retainedPiUpper (11200+k)) =
      sourceBlock11200PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 11200, retainedPiUpper 11200) =
      sourceBlock11200PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 11199, retainedPiUpper 11199) :=
      retainedPiPair_succ 11199
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11168PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11168PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11200PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11200PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11200PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11200 32 sourceBlock11200PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

