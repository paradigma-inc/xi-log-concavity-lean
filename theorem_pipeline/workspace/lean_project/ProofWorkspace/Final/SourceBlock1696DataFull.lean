  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1696 32 sourceBlock1696PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

