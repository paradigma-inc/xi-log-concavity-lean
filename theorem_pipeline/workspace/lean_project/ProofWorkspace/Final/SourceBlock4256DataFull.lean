theorem sourceBlock4256PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (4256+k), retainedPiUpper (4256+k)) =
      sourceBlock4256PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 4256, retainedPiUpper 4256) =
      sourceBlock4256PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 4255, retainedPiUpper 4255) :=
      retainedPiPair_succ 4255
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4224PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4224PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock4256PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock4256PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4256PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 4256 32 sourceBlock4256PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

