theorem sourceEtaBatch1984_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates1984 =
      (sourceEtaBatch1984Pairs, sourceEtaRootStates2016) := by
  decide +kernel

theorem sourceEtaRootStates2016_eq : sourceEtaRootStates2016 = etaRootStateTable 400 2016 := by
  have h := congrArg Prod.snd sourceEtaBatch1984_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1984_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch1984_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch1984Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1984+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1984+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch1984_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1984_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 1984)).1 =
    sourceEtaBatch1984Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 1984 32 k hk

def sourceEtaBatch1984Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch1984Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch1984Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch1984Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch1984_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch1984Lower k:ℝ) ≤ etaIntegral (xiGridArgument (1984+k):ℝ) ∧
      etaIntegral (xiGridArgument (1984+k):ℝ) ≤ (sourceEtaBatch1984Upper k:ℝ) := by
  unfold sourceEtaBatch1984Lower sourceEtaBatch1984Upper
  rw [sourceEtaBatch1984_entry k hk]
  exact ratEtaStream_retained_enclosure (1984+k)

theorem sourceEtaBatch1984_width : ∀ k : Fin 32,
    sourceEtaBatch1984Upper k - sourceEtaBatch1984Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

