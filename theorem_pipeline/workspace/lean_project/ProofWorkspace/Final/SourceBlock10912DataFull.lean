theorem sourceBlock10912PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10912+k), retainedPiUpper (10912+k)) =
      sourceBlock10912PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10912, retainedPiUpper 10912) =
      sourceBlock10912PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10911, retainedPiUpper 10911) :=
      retainedPiPair_succ 10911
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10880PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10880PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10912PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10912PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10912PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10912 32 sourceBlock10912PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

