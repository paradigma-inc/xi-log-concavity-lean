theorem sourceEtaBatch352_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates352 =
      (sourceEtaBatch352Pairs, sourceEtaRootStates384) := by
  decide +kernel

theorem sourceEtaRootStates384_eq : sourceEtaRootStates384 = etaRootStateTable 400 384 := by
  have h := congrArg Prod.snd sourceEtaBatch352_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates352_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch352_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch352Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (352+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (352+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch352_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates352_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 352)).1 =
    sourceEtaBatch352Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 352 32 k hk

def sourceEtaBatch352Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch352Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch352Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch352Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch352_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch352Lower k:ℝ) ≤ etaIntegral (xiGridArgument (352+k):ℝ) ∧
      etaIntegral (xiGridArgument (352+k):ℝ) ≤ (sourceEtaBatch352Upper k:ℝ) := by
  unfold sourceEtaBatch352Lower sourceEtaBatch352Upper
  rw [sourceEtaBatch352_entry k hk]
  exact ratEtaStream_retained_enclosure (352+k)

theorem sourceEtaBatch352_width : ∀ k : Fin 32,
    sourceEtaBatch352Upper k - sourceEtaBatch352Lower k < 1/(10:ℚ)^120 := by
