theorem sourceEtaBatch3552_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates3552 =
      (sourceEtaBatch3552Pairs, sourceEtaRootStates3584) := by
  decide +kernel

theorem sourceEtaRootStates3584_eq : sourceEtaRootStates3584 = etaRootStateTable 400 3584 := by
  have h := congrArg Prod.snd sourceEtaBatch3552_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates3552_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch3552_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch3552Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (3552+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (3552+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch3552_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates3552_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 3552)).1 =
    sourceEtaBatch3552Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 3552 32 k hk

def sourceEtaBatch3552Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch3552Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch3552Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch3552Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch3552_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch3552Lower k:ℝ) ≤ etaIntegral (xiGridArgument (3552+k):ℝ) ∧
      etaIntegral (xiGridArgument (3552+k):ℝ) ≤ (sourceEtaBatch3552Upper k:ℝ) := by
  unfold sourceEtaBatch3552Lower sourceEtaBatch3552Upper
  rw [sourceEtaBatch3552_entry k hk]
  exact ratEtaStream_retained_enclosure (3552+k)

theorem sourceEtaBatch3552_width : ∀ k : Fin 32,
    sourceEtaBatch3552Upper k - sourceEtaBatch3552Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

