      sourceBlock7296PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 7296, retainedPiUpper 7296) =
      sourceBlock7296PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 7295, retainedPiUpper 7295) :=
      retainedPiPair_succ 7295
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock7264PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock7264PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock7296PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock7296PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock7296PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 7296 32 sourceBlock7296PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

