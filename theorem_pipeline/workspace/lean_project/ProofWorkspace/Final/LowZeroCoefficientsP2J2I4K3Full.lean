def lowZeroCoefficientsP2J2I4K3State (n : ℕ) : ℚ × ℚ := lowZeroCoefficientsP2J2I4K3States.getD n (0,0)
def lowZeroCoefficientsP2J2I4K3Radius (n : ℕ) : ℚ := lowZeroCoefficientsP2J2I4K3Radii.getD n 0

theorem lowZeroCoefficientsP2J2I4K3_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP2J2I4K3Point ((25:ℚ)/4) ((1:ℚ)/4)
      sourcePiMidpoint 3 lowZeroCoefficientsP2J2I4K3State lowZeroCoefficientsP2J2I4K3Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP2J2I4K3_seed_eq : lowZeroCoefficientsP2J2I4K3State 0=lowZeroSeedP2J2I4K3State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP2J2I4K3_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP2J2I4K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J2I4K3Point)
        (Real.pi*(3:ℝ)^2) (((25:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J2I4K3State 0):ℝ) := by
  rw [lowZeroCoefficientsP2J2I4K3_seed_eq]
  have he := lowZeroSeedP2J2I4K3_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP2J2I4K3State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP2J2I4K3_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP2J2I4K3State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP2J2I4K3Point)
          (theta48PanelCenter 2 4:ℂ) (Real.pi*(3:ℝ)^2)
          (theta48PanelHalfWidth 2) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP2J2I4K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J2I4K3Point)
        (Real.pi*(3:ℝ)^2) (((25:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J2I4K3State 0):ℝ) := lowZeroCoefficientsP2J2I4K3_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP2J2I4K3Point
    ((25:ℚ)/4) ((1:ℚ)/4) 3 lowZeroCoefficientsP2J2I4K3State lowZeroCoefficientsP2J2I4K3Radius
    lowZeroCoefficientsP2J2I4K3_valid (by convert hs using 1 <;> norm_num)
  convert he using 1 <;> norm_num [theta48PanelCenter,theta48PanelHalfWidth]

