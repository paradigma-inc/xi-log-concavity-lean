  decide +kernel

theorem sourceEtaRootStates4352_eq : sourceEtaRootStates4352 = etaRootStateTable 400 4352 := by
  have h := congrArg Prod.snd sourceEtaBatch4320_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4320_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch4320_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch4320Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4320+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4320+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch4320_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4320_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 4320)).1 =
    sourceEtaBatch4320Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 4320 32 k hk

