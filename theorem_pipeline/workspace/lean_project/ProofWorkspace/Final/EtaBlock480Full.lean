theorem sourceEtaBatch480_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates480 =
      (sourceEtaBatch480Pairs, sourceEtaRootStates512) := by
  decide +kernel

theorem sourceEtaRootStates512_eq : sourceEtaRootStates512 = etaRootStateTable 400 512 := by
  have h := congrArg Prod.snd sourceEtaBatch480_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates480_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch480_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch480Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (480+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (480+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch480_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates480_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 480)).1 =
    sourceEtaBatch480Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 480 32 k hk

def sourceEtaBatch480Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch480Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch480Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch480Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch480_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch480Lower k:ℝ) ≤ etaIntegral (xiGridArgument (480+k):ℝ) ∧
      etaIntegral (xiGridArgument (480+k):ℝ) ≤ (sourceEtaBatch480Upper k:ℝ) := by
  unfold sourceEtaBatch480Lower sourceEtaBatch480Upper
  rw [sourceEtaBatch480_entry k hk]
  exact ratEtaStream_retained_enclosure (480+k)

theorem sourceEtaBatch480_width : ∀ k : Fin 32,
    sourceEtaBatch480Upper k - sourceEtaBatch480Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

