theorem sourceBlock10016PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10016+k), retainedPiUpper (10016+k)) =
      sourceBlock10016PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10016, retainedPiUpper 10016) =
      sourceBlock10016PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10015, retainedPiUpper 10015) :=
      retainedPiPair_succ 10015
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock9984PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock9984PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10016PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10016PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10016PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10016 32 sourceBlock10016PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

