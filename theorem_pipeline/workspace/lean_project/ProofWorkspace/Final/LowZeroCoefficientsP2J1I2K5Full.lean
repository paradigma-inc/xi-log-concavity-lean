def lowZeroCoefficientsP2J1I2K5Radius (n : ℕ) : ℚ := lowZeroCoefficientsP2J1I2K5Radii.getD n 0

theorem lowZeroCoefficientsP2J1I2K5_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP2J1I2K5Point ((21:ℚ)/8) ((1:ℚ)/8)
      sourcePiMidpoint 5 lowZeroCoefficientsP2J1I2K5State lowZeroCoefficientsP2J1I2K5Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP2J1I2K5_seed_eq : lowZeroCoefficientsP2J1I2K5State 0=lowZeroSeedP2J1I2K5State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP2J1I2K5_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP2J1I2K5State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J1I2K5Point)
        (Real.pi*(5:ℝ)^2) (((21:ℚ)/8):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J1I2K5State 0):ℝ) := by
  rw [lowZeroCoefficientsP2J1I2K5_seed_eq]
  have he := lowZeroSeedP2J1I2K5_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP2J1I2K5State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP2J1I2K5_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP2J1I2K5State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP2J1I2K5Point)
