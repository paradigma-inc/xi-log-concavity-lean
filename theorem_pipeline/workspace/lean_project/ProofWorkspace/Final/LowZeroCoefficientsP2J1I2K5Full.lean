  have hs : ‖ratComplexValue (lowZeroCoefficientsP2J1I2K5State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J1I2K5Point)
        (Real.pi*(5:ℝ)^2) (((21:ℚ)/8):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J1I2K5State 0):ℝ) := lowZeroCoefficientsP2J1I2K5_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP2J1I2K5Point
    ((21:ℚ)/8) ((1:ℚ)/8) 5 lowZeroCoefficientsP2J1I2K5State lowZeroCoefficientsP2J1I2K5Radius
