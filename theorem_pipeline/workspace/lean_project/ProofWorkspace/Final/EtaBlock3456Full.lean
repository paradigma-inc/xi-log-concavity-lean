theorem sourceEtaBatch3456_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates3456 =
      (sourceEtaBatch3456Pairs, sourceEtaRootStates3488) := by
  decide +kernel

theorem sourceEtaRootStates3488_eq : sourceEtaRootStates3488 = etaRootStateTable 400 3488 := by
  have h := congrArg Prod.snd sourceEtaBatch3456_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates3456_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch3456_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch3456Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (3456+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (3456+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch3456_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates3456_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 3456)).1 =
    sourceEtaBatch3456Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 3456 32 k hk

def sourceEtaBatch3456Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch3456Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch3456Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch3456Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch3456_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch3456Lower k:ℝ) ≤ etaIntegral (xiGridArgument (3456+k):ℝ) ∧
      etaIntegral (xiGridArgument (3456+k):ℝ) ≤ (sourceEtaBatch3456Upper k:ℝ) := by
  unfold sourceEtaBatch3456Lower sourceEtaBatch3456Upper
  rw [sourceEtaBatch3456_entry k hk]
  exact ratEtaStream_retained_enclosure (3456+k)

theorem sourceEtaBatch3456_width : ∀ k : Fin 32,
    sourceEtaBatch3456Upper k - sourceEtaBatch3456Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

