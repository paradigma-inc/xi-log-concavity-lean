theorem sourceBlock1024PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (1024+k), retainedPiUpper (1024+k)) =
      sourceBlock1024PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 1024, retainedPiUpper 1024) =
      sourceBlock1024PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 1023, retainedPiUpper 1023) :=
      retainedPiPair_succ 1023
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock992PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock992PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1024PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1024PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1024PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1024 32 sourceBlock1024PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

