theorem sourceBlock12608PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12608+k), retainedPiUpper (12608+k)) =
      sourceBlock12608PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12608, retainedPiUpper 12608) =
      sourceBlock12608PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12607, retainedPiUpper 12607) :=
      retainedPiPair_succ 12607
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12576PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12576PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12608PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12608PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12608PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12608 32 sourceBlock12608PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

