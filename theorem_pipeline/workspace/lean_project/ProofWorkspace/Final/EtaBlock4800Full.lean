theorem sourceEtaBatch4800_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates4800 =
      (sourceEtaBatch4800Pairs, sourceEtaRootStates4832) := by
  decide +kernel

theorem sourceEtaRootStates4832_eq : sourceEtaRootStates4832 = etaRootStateTable 400 4832 := by
  have h := congrArg Prod.snd sourceEtaBatch4800_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4800_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch4800_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch4800Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4800+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4800+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch4800_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4800_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 4800)).1 =
    sourceEtaBatch4800Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 4800 32 k hk

def sourceEtaBatch4800Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch4800Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch4800Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch4800Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch4800_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch4800Lower k:ℝ) ≤ etaIntegral (xiGridArgument (4800+k):ℝ) ∧
      etaIntegral (xiGridArgument (4800+k):ℝ) ≤ (sourceEtaBatch4800Upper k:ℝ) := by
  unfold sourceEtaBatch4800Lower sourceEtaBatch4800Upper
  rw [sourceEtaBatch4800_entry k hk]
  exact ratEtaStream_retained_enclosure (4800+k)

