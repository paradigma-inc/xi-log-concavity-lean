theorem sourceBlock8000PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8000+k), retainedPiUpper (8000+k)) =
      sourceBlock8000PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8000, retainedPiUpper 8000) =
      sourceBlock8000PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 7999, retainedPiUpper 7999) :=
      retainedPiPair_succ 7999
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock7968PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock7968PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8000PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8000PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8000PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8000 32 sourceBlock8000PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

