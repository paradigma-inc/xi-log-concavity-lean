        (Real.pi*(2:ℝ)^2) (((17:ℚ)/1):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J4I0K2State 0):ℝ) := lowZeroCoefficientsP3J4I0K2_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP3J4I0K2Point
    ((17:ℚ)/1) ((1:ℚ)/1) 2 lowZeroCoefficientsP3J4I0K2State lowZeroCoefficientsP3J4I0K2Radius
