theorem lowZeroCoefficientsP3J4I0K2_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP3J4I0K2Point ((17:ℚ)/1) ((1:ℚ)/1)
      sourcePiMidpoint 2 lowZeroCoefficientsP3J4I0K2State lowZeroCoefficientsP3J4I0K2Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP3J4I0K2_seed_eq : lowZeroCoefficientsP3J4I0K2State 0=lowZeroSeedP3J4I0K2State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP3J4I0K2_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP3J4I0K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP3J4I0K2Point)
        (Real.pi*(2:ℝ)^2) (((17:ℚ)/1):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J4I0K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP3J4I0K2_seed_eq]
  have he := lowZeroSeedP3J4I0K2_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP3J4I0K2State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

