theorem sourceBlock8128PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8128+k), retainedPiUpper (8128+k)) =
      sourceBlock8128PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8128, retainedPiUpper 8128) =
      sourceBlock8128PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8127, retainedPiUpper 8127) :=
      retainedPiPair_succ 8127
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8096PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8096PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8128PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8128PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8128PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8128 32 sourceBlock8128PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

