theorem sourceEtaBatch2784_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates2784 =
      (sourceEtaBatch2784Pairs, sourceEtaRootStates2816) := by
  decide +kernel

theorem sourceEtaRootStates2816_eq : sourceEtaRootStates2816 = etaRootStateTable 400 2816 := by
  have h := congrArg Prod.snd sourceEtaBatch2784_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates2784_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch2784_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch2784Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (2784+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (2784+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch2784_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates2784_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 2784)).1 =
    sourceEtaBatch2784Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 2784 32 k hk

def sourceEtaBatch2784Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch2784Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch2784Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch2784Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch2784_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch2784Lower k:ℝ) ≤ etaIntegral (xiGridArgument (2784+k):ℝ) ∧
      etaIntegral (xiGridArgument (2784+k):ℝ) ≤ (sourceEtaBatch2784Upper k:ℝ) := by
  unfold sourceEtaBatch2784Lower sourceEtaBatch2784Upper
  rw [sourceEtaBatch2784_entry k hk]
