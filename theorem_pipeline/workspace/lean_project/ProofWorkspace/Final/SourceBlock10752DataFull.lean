  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10752 32 sourceBlock10752PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

