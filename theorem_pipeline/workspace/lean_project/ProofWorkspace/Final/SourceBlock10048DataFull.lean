theorem sourceBlock10048PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10048+k), retainedPiUpper (10048+k)) =
      sourceBlock10048PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10048, retainedPiUpper 10048) =
      sourceBlock10048PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10047, retainedPiUpper 10047) :=
      retainedPiPair_succ 10047
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10016PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10016PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10048PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10048PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10048PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10048 32 sourceBlock10048PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

