  have hs : ‖ratComplexValue (lowZeroCoefficientsP3J2I6K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP3J2I6K3Point)
        (Real.pi*(3:ℝ)^2) (((29:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J2I6K3State 0):ℝ) := lowZeroCoefficientsP3J2I6K3_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP3J2I6K3Point
    ((29:ℚ)/4) ((1:ℚ)/4) 3 lowZeroCoefficientsP3J2I6K3State lowZeroCoefficientsP3J2I6K3Radius
    lowZeroCoefficientsP3J2I6K3_valid (by convert hs using 1 <;> norm_num)
