def lowZeroCoefficientsP3J2I6K3State (n : ℕ) : ℚ × ℚ := lowZeroCoefficientsP3J2I6K3States.getD n (0,0)
def lowZeroCoefficientsP3J2I6K3Radius (n : ℕ) : ℚ := lowZeroCoefficientsP3J2I6K3Radii.getD n 0

theorem lowZeroCoefficientsP3J2I6K3_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP3J2I6K3Point ((29:ℚ)/4) ((1:ℚ)/4)
      sourcePiMidpoint 3 lowZeroCoefficientsP3J2I6K3State lowZeroCoefficientsP3J2I6K3Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP3J2I6K3_seed_eq : lowZeroCoefficientsP3J2I6K3State 0=lowZeroSeedP3J2I6K3State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP3J2I6K3_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP3J2I6K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP3J2I6K3Point)
        (Real.pi*(3:ℝ)^2) (((29:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J2I6K3State 0):ℝ) := by
  rw [lowZeroCoefficientsP3J2I6K3_seed_eq]
  have he := lowZeroSeedP3J2I6K3_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP3J2I6K3State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP3J2I6K3_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP3J2I6K3State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP3J2I6K3Point)
          (theta48PanelCenter 2 6:ℂ) (Real.pi*(3:ℝ)^2)
