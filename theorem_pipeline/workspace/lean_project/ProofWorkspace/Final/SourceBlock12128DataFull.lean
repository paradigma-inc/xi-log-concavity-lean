theorem sourceBlock12128PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12128+k), retainedPiUpper (12128+k)) =
      sourceBlock12128PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12128, retainedPiUpper 12128) =
      sourceBlock12128PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12127, retainedPiUpper 12127) :=
      retainedPiPair_succ 12127
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12096PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12096PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12128PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12128PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12128PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12128 32 sourceBlock12128PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

