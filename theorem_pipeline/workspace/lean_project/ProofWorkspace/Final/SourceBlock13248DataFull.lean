      sourceBlock13248PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 13247, retainedPiUpper 13247) :=
      retainedPiPair_succ 13247
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13216PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock13216PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock13248PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock13248PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13248PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 13248 32 sourceBlock13248PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

