theorem sourceBlock4448PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (4448+k), retainedPiUpper (4448+k)) =
      sourceBlock4448PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 4448, retainedPiUpper 4448) =
      sourceBlock4448PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 4447, retainedPiUpper 4447) :=
      retainedPiPair_succ 4447
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4416PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4416PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock4448PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock4448PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4448PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 4448 32 sourceBlock4448PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

