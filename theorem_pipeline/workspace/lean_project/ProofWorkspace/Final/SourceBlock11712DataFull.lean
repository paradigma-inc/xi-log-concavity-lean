theorem sourceBlock11712PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (11712+k), retainedPiUpper (11712+k)) =
      sourceBlock11712PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 11712, retainedPiUpper 11712) =
      sourceBlock11712PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 11711, retainedPiUpper 11711) :=
      retainedPiPair_succ 11711
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11680PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11680PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11712PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11712PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11712PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11712 32 sourceBlock11712PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

