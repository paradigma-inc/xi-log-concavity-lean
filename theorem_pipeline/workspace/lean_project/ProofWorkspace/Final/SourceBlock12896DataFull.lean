theorem sourceBlock12896PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12896+k), retainedPiUpper (12896+k)) =
      sourceBlock12896PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12896, retainedPiUpper 12896) =
      sourceBlock12896PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12895, retainedPiUpper 12895) :=
      retainedPiPair_succ 12895
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12864PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12864PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12896PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12896PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12896PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12896 32 sourceBlock12896PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

