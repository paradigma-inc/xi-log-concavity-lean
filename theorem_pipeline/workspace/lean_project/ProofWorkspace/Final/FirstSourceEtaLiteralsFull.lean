    ratEtaRootGridUpper 400 1 rootCertificateScale rootLowerFor rootUpperFor) = _
  rw [←ratEtaRootIntegerLower_eq, ←ratEtaRootIntegerUpper_eq]
  unfold ratEtaRootIntegerLower ratEtaRootIntegerUpper
