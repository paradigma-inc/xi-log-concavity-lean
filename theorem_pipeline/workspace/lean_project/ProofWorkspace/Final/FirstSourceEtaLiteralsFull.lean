theorem etaNodeZero_literals :
    (ratEtaRootTableLower 400 0 (10^180) rootLowerFor rootUpperFor,
      ratEtaRootTableUpper 400 0 (10^180) rootLowerFor rootUpperFor) =
      (etaNodeZeroLower, etaNodeZeroUpper) := by
  rw [ratEtaRootTableLower_eq, ratEtaRootTableUpper_eq]
  change (ratEtaRootGridLower 400 0 rootCertificateScale rootLowerFor rootUpperFor,
    ratEtaRootGridUpper 400 0 rootCertificateScale rootLowerFor rootUpperFor) = _
  rw [←ratEtaRootIntegerLower_eq, ←ratEtaRootIntegerUpper_eq]
  unfold ratEtaRootIntegerLower ratEtaRootIntegerUpper
  rw [etaNodeZeroLower_integer_sum, etaNodeZeroUpper_integer_sum]
  decide +kernel

theorem etaNodeOne_literals :
