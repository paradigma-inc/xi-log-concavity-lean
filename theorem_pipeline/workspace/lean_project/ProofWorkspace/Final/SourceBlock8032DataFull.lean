theorem sourceBlock8032PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8032+k), retainedPiUpper (8032+k)) =
      sourceBlock8032PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8032, retainedPiUpper 8032) =
      sourceBlock8032PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8031, retainedPiUpper 8031) :=
      retainedPiPair_succ 8031
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8000PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8000PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8032PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8032PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8032PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8032 32 sourceBlock8032PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

