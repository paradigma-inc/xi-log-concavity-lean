      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock1728PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1760PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1760PiPairs.getD (k+1) (0,0) =
