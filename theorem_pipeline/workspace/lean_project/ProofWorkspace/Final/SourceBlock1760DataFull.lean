  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1760 32 sourceBlock1760PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

