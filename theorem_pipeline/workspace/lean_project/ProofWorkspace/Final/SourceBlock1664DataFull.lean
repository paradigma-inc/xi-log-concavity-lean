theorem sourceBlock1664PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (1664+k), retainedPiUpper (1664+k)) =
      sourceBlock1664PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 1664, retainedPiUpper 1664) =
      sourceBlock1664PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 1663, retainedPiUpper 1663) :=
      retainedPiPair_succ 1663
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1632PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock1632PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1664PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1664PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1664PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1664 32 sourceBlock1664PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

