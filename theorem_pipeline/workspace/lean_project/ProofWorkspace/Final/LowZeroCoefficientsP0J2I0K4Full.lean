  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP0J2I0K4Point
    ((17:ℚ)/4) ((1:ℚ)/4) 4 lowZeroCoefficientsP0J2I0K4State lowZeroCoefficientsP0J2I0K4Radius
