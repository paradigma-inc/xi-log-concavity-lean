  decide +kernel

theorem lowZeroCoefficientsP0J2I0K4_seed_eq : lowZeroCoefficientsP0J2I0K4State 0=lowZeroSeedP0J2I0K4State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP0J2I0K4_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP0J2I0K4State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP0J2I0K4Point)
        (Real.pi*(4:ℝ)^2) (((17:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP0J2I0K4State 0):ℝ) := by
  rw [lowZeroCoefficientsP0J2I0K4_seed_eq]
  have he := lowZeroSeedP0J2I0K4_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP0J2I0K4State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

