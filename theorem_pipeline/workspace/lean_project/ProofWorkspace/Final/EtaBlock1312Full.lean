theorem sourceEtaBatch1312_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates1312 =
      (sourceEtaBatch1312Pairs, sourceEtaRootStates1344) := by
  decide +kernel

theorem sourceEtaRootStates1344_eq : sourceEtaRootStates1344 = etaRootStateTable 400 1344 := by
  have h := congrArg Prod.snd sourceEtaBatch1312_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1312_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch1312_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch1312Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1312+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1312+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch1312_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1312_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 1312)).1 =
    sourceEtaBatch1312Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 1312 32 k hk

def sourceEtaBatch1312Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch1312Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch1312Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch1312Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch1312_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch1312Lower k:ℝ) ≤ etaIntegral (xiGridArgument (1312+k):ℝ) ∧
      etaIntegral (xiGridArgument (1312+k):ℝ) ≤ (sourceEtaBatch1312Upper k:ℝ) := by
  unfold sourceEtaBatch1312Lower sourceEtaBatch1312Upper
  rw [sourceEtaBatch1312_entry k hk]
  exact ratEtaStream_retained_enclosure (1312+k)

theorem sourceEtaBatch1312_width : ∀ k : Fin 32,
    sourceEtaBatch1312Upper k - sourceEtaBatch1312Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

