theorem sourceBlock2080PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (2080+k), retainedPiUpper (2080+k)) =
      sourceBlock2080PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 2080, retainedPiUpper 2080) =
      sourceBlock2080PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 2079, retainedPiUpper 2079) :=
      retainedPiPair_succ 2079
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock2048PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock2048PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock2080PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock2080PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock2080PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 2080 32 sourceBlock2080PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

