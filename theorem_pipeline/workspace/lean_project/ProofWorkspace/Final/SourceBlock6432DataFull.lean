theorem sourceBlock6432PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (6432+k), retainedPiUpper (6432+k)) =
      sourceBlock6432PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 6432, retainedPiUpper 6432) =
      sourceBlock6432PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 6431, retainedPiUpper 6431) :=
      retainedPiPair_succ 6431
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6400PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock6400PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock6432PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock6432PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6432PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 6432 32 sourceBlock6432PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

