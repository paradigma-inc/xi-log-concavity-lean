          (theta48PanelHalfWidth 3) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP4J3I5K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J3I5K2Point)
        (Real.pi*(2:ℝ)^2) (((27:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J3I5K2State 0):ℝ) := lowZeroCoefficientsP4J3I5K2_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP4J3I5K2Point
    ((27:ℚ)/2) ((1:ℚ)/2) 2 lowZeroCoefficientsP4J3I5K2State lowZeroCoefficientsP4J3I5K2Radius
