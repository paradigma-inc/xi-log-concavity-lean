theorem sourceBlock1312PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (1312+k), retainedPiUpper (1312+k)) =
      sourceBlock1312PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 1312, retainedPiUpper 1312) =
      sourceBlock1312PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 1311, retainedPiUpper 1311) :=
      retainedPiPair_succ 1311
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1280PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock1280PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1312PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1312PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1312PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1312 32 sourceBlock1312PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

