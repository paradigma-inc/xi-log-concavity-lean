      etaIntegral (xiGridArgument (2144+k):ℝ) ≤ (sourceEtaBatch2144Upper k:ℝ) := by
  unfold sourceEtaBatch2144Lower sourceEtaBatch2144Upper
  rw [sourceEtaBatch2144_entry k hk]
  exact ratEtaStream_retained_enclosure (2144+k)

theorem sourceEtaBatch2144_width : ∀ k : Fin 32,
    sourceEtaBatch2144Upper k - sourceEtaBatch2144Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
