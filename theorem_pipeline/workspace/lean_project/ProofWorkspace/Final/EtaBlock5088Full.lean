theorem sourceEtaBatch5088_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates5088 =
      (sourceEtaBatch5088Pairs, sourceEtaRootStates5120) := by
  decide +kernel

theorem sourceEtaRootStates5120_eq : sourceEtaRootStates5120 = etaRootStateTable 400 5120 := by
  have h := congrArg Prod.snd sourceEtaBatch5088_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates5088_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch5088_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch5088Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (5088+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (5088+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch5088_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates5088_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 5088)).1 =
    sourceEtaBatch5088Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 5088 32 k hk

def sourceEtaBatch5088Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch5088Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch5088Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch5088Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch5088_actual_enclosure (k : ℕ) (hk : k < 32) :
