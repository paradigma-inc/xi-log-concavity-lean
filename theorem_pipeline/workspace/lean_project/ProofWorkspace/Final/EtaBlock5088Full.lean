      etaIntegral (xiGridArgument (5088+k):ℝ) ≤ (sourceEtaBatch5088Upper k:ℝ) := by
  unfold sourceEtaBatch5088Lower sourceEtaBatch5088Upper
  rw [sourceEtaBatch5088_entry k hk]
