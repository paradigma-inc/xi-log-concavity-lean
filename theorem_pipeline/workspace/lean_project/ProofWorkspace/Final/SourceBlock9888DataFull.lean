theorem sourceBlock9888PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (9888+k), retainedPiUpper (9888+k)) =
      sourceBlock9888PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 9888, retainedPiUpper 9888) =
      sourceBlock9888PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 9887, retainedPiUpper 9887) :=
      retainedPiPair_succ 9887
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock9856PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock9856PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock9888PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock9888PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock9888PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 9888 32 sourceBlock9888PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

