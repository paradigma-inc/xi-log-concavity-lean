      retainedPiPair_succ 1535
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1504PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock1504PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1536PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1536PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1536PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1536 32 sourceBlock1536PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

