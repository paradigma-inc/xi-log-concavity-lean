theorem sourceBlock1536PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (1536+k), retainedPiUpper (1536+k)) =
      sourceBlock1536PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 1536, retainedPiUpper 1536) =
      sourceBlock1536PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
