      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock1856PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1888PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1888PiPairs.getD (k+1) (0,0) =
