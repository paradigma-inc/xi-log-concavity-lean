theorem sourceBlock12480PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12480+k), retainedPiUpper (12480+k)) =
      sourceBlock12480PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12480, retainedPiUpper 12480) =
      sourceBlock12480PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12479, retainedPiUpper 12479) :=
      retainedPiPair_succ 12479
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12448PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12448PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12480PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12480PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12480PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12480 32 sourceBlock12480PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

