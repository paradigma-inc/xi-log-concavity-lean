theorem sourceBlock2848PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (2848+k), retainedPiUpper (2848+k)) =
      sourceBlock2848PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 2848, retainedPiUpper 2848) =
      sourceBlock2848PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 2847, retainedPiUpper 2847) :=
      retainedPiPair_succ 2847
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock2816PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock2816PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock2848PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock2848PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock2848PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 2848 32 sourceBlock2848PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

