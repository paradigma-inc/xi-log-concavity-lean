theorem sourceBlock4032PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (4032+k), retainedPiUpper (4032+k)) =
      sourceBlock4032PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 4032, retainedPiUpper 4032) =
      sourceBlock4032PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 4031, retainedPiUpper 4031) :=
      retainedPiPair_succ 4031
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4000PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4000PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock4032PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock4032PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4032PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 4032 32 sourceBlock4032PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

