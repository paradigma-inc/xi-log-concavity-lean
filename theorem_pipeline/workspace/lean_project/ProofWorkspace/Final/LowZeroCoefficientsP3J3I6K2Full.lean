theorem lowZeroCoefficientsP3J3I6K2_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP3J3I6K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP3J3I6K2Point)
        (Real.pi*(2:ℝ)^2) (((29:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J3I6K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP3J3I6K2_seed_eq]
  have he := lowZeroSeedP3J3I6K2_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP3J3I6K2State 16))
