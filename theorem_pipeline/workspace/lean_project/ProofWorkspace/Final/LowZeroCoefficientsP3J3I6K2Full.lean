theorem lowZeroCoefficientsP3J3I6K2_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP3J3I6K2Point ((29:ℚ)/2) ((1:ℚ)/2)
      sourcePiMidpoint 2 lowZeroCoefficientsP3J3I6K2State lowZeroCoefficientsP3J3I6K2Radius := by
