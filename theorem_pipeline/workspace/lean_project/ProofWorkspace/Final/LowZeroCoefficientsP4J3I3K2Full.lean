theorem lowZeroCoefficientsP4J3I3K2_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP4J3I3K2Point ((23:ℚ)/2) ((1:ℚ)/2)
      sourcePiMidpoint 2 lowZeroCoefficientsP4J3I3K2State lowZeroCoefficientsP4J3I3K2Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP4J3I3K2_seed_eq : lowZeroCoefficientsP4J3I3K2State 0=lowZeroSeedP4J3I3K2State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP4J3I3K2_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP4J3I3K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J3I3K2Point)
        (Real.pi*(2:ℝ)^2) (((23:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J3I3K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP4J3I3K2_seed_eq]
  have he := lowZeroSeedP4J3I3K2_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP4J3I3K2State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

