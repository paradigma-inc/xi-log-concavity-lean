    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP3J3I3K2State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP3J3I3K2Point)
          (theta48PanelCenter 3 3:ℂ) (Real.pi*(2:ℝ)^2)
          (theta48PanelHalfWidth 3) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP3J3I3K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP3J3I3K2Point)
        (Real.pi*(2:ℝ)^2) (((23:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J3I3K2State 0):ℝ) := lowZeroCoefficientsP3J3I3K2_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP3J3I3K2Point
    ((23:ℚ)/2) ((1:ℚ)/2) 2 lowZeroCoefficientsP3J3I3K2State lowZeroCoefficientsP3J3I3K2Radius
