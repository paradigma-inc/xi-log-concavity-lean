theorem sourceBlock8800PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8800+k), retainedPiUpper (8800+k)) =
      sourceBlock8800PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8800, retainedPiUpper 8800) =
      sourceBlock8800PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8799, retainedPiUpper 8799) :=
      retainedPiPair_succ 8799
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8768PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8768PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8800PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8800PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8800PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8800 32 sourceBlock8800PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

