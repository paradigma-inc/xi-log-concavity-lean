theorem sourceBlock12704PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12704+k), retainedPiUpper (12704+k)) =
      sourceBlock12704PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12704, retainedPiUpper 12704) =
      sourceBlock12704PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12703, retainedPiUpper 12703) :=
      retainedPiPair_succ 12703
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12672PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12672PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12704PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12704PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12704PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12704 32 sourceBlock12704PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

