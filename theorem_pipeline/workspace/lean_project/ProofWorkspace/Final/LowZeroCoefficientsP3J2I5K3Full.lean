        (Real.pi*(3:ℝ)^2) (((27:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J2I5K3State 0):ℝ) := lowZeroCoefficientsP3J2I5K3_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP3J2I5K3Point
    ((27:ℚ)/4) ((1:ℚ)/4) 3 lowZeroCoefficientsP3J2I5K3State lowZeroCoefficientsP3J2I5K3Radius
