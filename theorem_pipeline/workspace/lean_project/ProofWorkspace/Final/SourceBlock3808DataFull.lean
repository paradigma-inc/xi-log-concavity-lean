theorem sourceBlock3808PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (3808+k), retainedPiUpper (3808+k)) =
      sourceBlock3808PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 3808, retainedPiUpper 3808) =
      sourceBlock3808PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 3807, retainedPiUpper 3807) :=
      retainedPiPair_succ 3807
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3776PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock3776PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock3808PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock3808PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3808PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 3808 32 sourceBlock3808PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

