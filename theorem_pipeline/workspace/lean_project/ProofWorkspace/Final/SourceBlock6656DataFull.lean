    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 6655, retainedPiUpper 6655) :=
      retainedPiPair_succ 6655
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6624PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock6624PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock6656PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock6656PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6656PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 6656 32 sourceBlock6656PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

