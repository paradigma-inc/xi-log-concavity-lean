theorem sourceEtaBatch544_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates544 =
      (sourceEtaBatch544Pairs, sourceEtaRootStates576) := by
  decide +kernel

theorem sourceEtaRootStates576_eq : sourceEtaRootStates576 = etaRootStateTable 400 576 := by
  have h := congrArg Prod.snd sourceEtaBatch544_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates544_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch544_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch544Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (544+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (544+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch544_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates544_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 544)).1 =
    sourceEtaBatch544Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 544 32 k hk

def sourceEtaBatch544Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch544Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch544Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch544Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch544_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch544Lower k:ℝ) ≤ etaIntegral (xiGridArgument (544+k):ℝ) ∧
      etaIntegral (xiGridArgument (544+k):ℝ) ≤ (sourceEtaBatch544Upper k:ℝ) := by
  unfold sourceEtaBatch544Lower sourceEtaBatch544Upper
  rw [sourceEtaBatch544_entry k hk]
  exact ratEtaStream_retained_enclosure (544+k)

theorem sourceEtaBatch544_width : ∀ k : Fin 32,
    sourceEtaBatch544Upper k - sourceEtaBatch544Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

