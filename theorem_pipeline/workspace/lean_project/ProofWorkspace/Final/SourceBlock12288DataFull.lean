theorem sourceBlock12288PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12288+k), retainedPiUpper (12288+k)) =
      sourceBlock12288PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12288, retainedPiUpper 12288) =
      sourceBlock12288PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12287, retainedPiUpper 12287) :=
      retainedPiPair_succ 12287
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12256PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12256PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12288PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12288PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12288PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12288 32 sourceBlock12288PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12288TwoPairs_eq : ∀ k : Fin 32,
    (retainedTwoLower (12288+k), retainedTwoUpper (12288+k)) =
      sourceBlock12288TwoPairs.getD k (0,0) := by
  have hfirst : (retainedTwoLower 12288, retainedTwoUpper 12288) =
      sourceBlock12288TwoPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)
        (retainedTwoLower 12287, retainedTwoUpper 12287) :=
      retainedTwoPair_succ 12287
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12256TwoPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) (sourceBlock12256TwoPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12288TwoPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12288TwoPairs.getD (k+1) (0,0) =
        sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12288TwoPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedTwoLower j, retainedTwoUpper j))
    (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) retainedTwoPair_succ 12288 32 sourceBlock12288TwoPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12288Midpoints_slice_checked :
    sourceBlock12288Midpoints = (sourceMidpointArray.toList.drop 12288).take 32 := by
  decide +kernel

theorem sourceBlock12288Midpoints_eq_array : ∀ k : Fin 32,
    sourceBlock12288Midpoints.getD k 0 = sourceRoundedMidpoint (12288+k) := by
  intro k
  exact sourceMidpointSlice_lookup 12288 32 sourceBlock12288Midpoints
    sourceBlock12288Midpoints_slice_checked k k.isLt

