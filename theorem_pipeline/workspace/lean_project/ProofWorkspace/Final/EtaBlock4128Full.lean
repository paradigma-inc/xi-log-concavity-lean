theorem sourceEtaBatch4128_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates4128 =
      (sourceEtaBatch4128Pairs, sourceEtaRootStates4160) := by
  decide +kernel

theorem sourceEtaRootStates4160_eq : sourceEtaRootStates4160 = etaRootStateTable 400 4160 := by
  have h := congrArg Prod.snd sourceEtaBatch4128_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4128_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch4128_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch4128Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4128+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4128+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch4128_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4128_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 4128)).1 =
    sourceEtaBatch4128Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 4128 32 k hk

def sourceEtaBatch4128Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch4128Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch4128Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch4128Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch4128_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch4128Lower k:ℝ) ≤ etaIntegral (xiGridArgument (4128+k):ℝ) ∧
      etaIntegral (xiGridArgument (4128+k):ℝ) ≤ (sourceEtaBatch4128Upper k:ℝ) := by
  unfold sourceEtaBatch4128Lower sourceEtaBatch4128Upper
  rw [sourceEtaBatch4128_entry k hk]
  exact ratEtaStream_retained_enclosure (4128+k)

theorem sourceEtaBatch4128_width : ∀ k : Fin 32,
    sourceEtaBatch4128Upper k - sourceEtaBatch4128Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

