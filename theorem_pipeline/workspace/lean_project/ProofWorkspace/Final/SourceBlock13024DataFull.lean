theorem sourceBlock13024PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (13024+k), retainedPiUpper (13024+k)) =
      sourceBlock13024PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 13024, retainedPiUpper 13024) =
      sourceBlock13024PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 13023, retainedPiUpper 13023) :=
      retainedPiPair_succ 13023
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12992PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12992PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock13024PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock13024PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13024PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 13024 32 sourceBlock13024PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

