theorem sourceBlock10304PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10304+k), retainedPiUpper (10304+k)) =
      sourceBlock10304PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10304, retainedPiUpper 10304) =
      sourceBlock10304PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10303, retainedPiUpper 10303) :=
      retainedPiPair_succ 10303
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10272PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10272PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10304PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10304PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10304PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10304 32 sourceBlock10304PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

