theorem sourceBlock1856PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (1856+k), retainedPiUpper (1856+k)) =
      sourceBlock1856PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 1856, retainedPiUpper 1856) =
      sourceBlock1856PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 1855, retainedPiUpper 1855) :=
      retainedPiPair_succ 1855
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1824PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock1824PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1856PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1856PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1856PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1856 32 sourceBlock1856PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

