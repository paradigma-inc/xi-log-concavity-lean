theorem sourceEtaBatch512_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates512 =
      (sourceEtaBatch512Pairs, sourceEtaRootStates544) := by
  decide +kernel

theorem sourceEtaRootStates544_eq : sourceEtaRootStates544 = etaRootStateTable 400 544 := by
  have h := congrArg Prod.snd sourceEtaBatch512_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates512_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch512_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch512Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (512+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (512+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch512_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates512_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 512)).1 =
    sourceEtaBatch512Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 512 32 k hk

def sourceEtaBatch512Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch512Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch512Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch512Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch512_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch512Lower k:ℝ) ≤ etaIntegral (xiGridArgument (512+k):ℝ) ∧
      etaIntegral (xiGridArgument (512+k):ℝ) ≤ (sourceEtaBatch512Upper k:ℝ) := by
  unfold sourceEtaBatch512Lower sourceEtaBatch512Upper
  rw [sourceEtaBatch512_entry k hk]
  exact ratEtaStream_retained_enclosure (512+k)

theorem sourceEtaBatch512_width : ∀ k : Fin 32,
    sourceEtaBatch512Upper k - sourceEtaBatch512Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

