    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4256PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4256PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock4288PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock4288PiPairs.getD (k+1) (0,0) =
