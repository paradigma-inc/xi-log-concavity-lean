theorem sourceBlock12096PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12096+k), retainedPiUpper (12096+k)) =
      sourceBlock12096PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12096, retainedPiUpper 12096) =
      sourceBlock12096PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12095, retainedPiUpper 12095) :=
      retainedPiPair_succ 12095
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12064PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12064PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12096PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12096PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12096PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12096 32 sourceBlock12096PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

