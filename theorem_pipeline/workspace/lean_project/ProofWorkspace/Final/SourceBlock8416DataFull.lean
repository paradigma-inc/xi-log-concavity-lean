theorem sourceBlock8416PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8416+k), retainedPiUpper (8416+k)) =
      sourceBlock8416PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8416, retainedPiUpper 8416) =
      sourceBlock8416PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8415, retainedPiUpper 8415) :=
      retainedPiPair_succ 8415
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8384PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8384PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8416PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8416PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8416PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8416 32 sourceBlock8416PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

