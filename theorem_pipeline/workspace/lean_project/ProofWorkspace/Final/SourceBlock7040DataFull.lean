        (retainedPiLower 7039, retainedPiUpper 7039) :=
      retainedPiPair_succ 7039
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock7008PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock7008PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock7040PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock7040PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock7040PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 7040 32 sourceBlock7040PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

