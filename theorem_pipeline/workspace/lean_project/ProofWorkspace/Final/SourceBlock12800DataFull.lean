theorem sourceBlock12800PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12800+k), retainedPiUpper (12800+k)) =
      sourceBlock12800PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12800, retainedPiUpper 12800) =
      sourceBlock12800PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12799, retainedPiUpper 12799) :=
      retainedPiPair_succ 12799
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12768PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12768PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12800PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12800PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12800PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12800 32 sourceBlock12800PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

