theorem sourceBlock4128PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (4128+k), retainedPiUpper (4128+k)) =
      sourceBlock4128PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 4128, retainedPiUpper 4128) =
      sourceBlock4128PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 4127, retainedPiUpper 4127) :=
      retainedPiPair_succ 4127
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4096PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4096PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock4128PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock4128PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4128PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 4128 32 sourceBlock4128PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

