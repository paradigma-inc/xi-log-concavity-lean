        (Real.pi*(2:ℝ)^2) (((29:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP0J3I6K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP0J3I6K2_seed_eq]
  have he := lowZeroSeedP0J3I6K2_actual_atom_error
