      sourceBlock12352PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12352, retainedPiUpper 12352) =
      sourceBlock12352PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12351, retainedPiUpper 12351) :=
      retainedPiPair_succ 12351
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12320PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12320PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12352PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12352PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12352PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12352 32 sourceBlock12352PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

