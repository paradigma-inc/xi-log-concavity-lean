  decide +kernel

theorem lowZeroCoefficientsP0J4I0K2_seed_eq : lowZeroCoefficientsP0J4I0K2State 0=lowZeroSeedP0J4I0K2State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP0J4I0K2_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP0J4I0K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP0J4I0K2Point)
        (Real.pi*(2:ℝ)^2) (((17:ℚ)/1):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP0J4I0K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP0J4I0K2_seed_eq]
  have he := lowZeroSeedP0J4I0K2_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP0J4I0K2State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

