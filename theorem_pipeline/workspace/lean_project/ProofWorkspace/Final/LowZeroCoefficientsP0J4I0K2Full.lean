  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP0J4I0K2Point
    ((17:ℚ)/1) ((1:ℚ)/1) 2 lowZeroCoefficientsP0J4I0K2State lowZeroCoefficientsP0J4I0K2Radius
