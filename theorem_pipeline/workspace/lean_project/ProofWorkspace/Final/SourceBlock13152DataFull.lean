theorem sourceBlock13152PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (13152+k), retainedPiUpper (13152+k)) =
      sourceBlock13152PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 13152, retainedPiUpper 13152) =
      sourceBlock13152PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 13151, retainedPiUpper 13151) :=
      retainedPiPair_succ 13151
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13120PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock13120PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock13152PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock13152PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13152PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 13152 32 sourceBlock13152PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

