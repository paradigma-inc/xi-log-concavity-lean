theorem sourceBlock12256PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12256+k), retainedPiUpper (12256+k)) =
      sourceBlock12256PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12256, retainedPiUpper 12256) =
      sourceBlock12256PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12255, retainedPiUpper 12255) :=
      retainedPiPair_succ 12255
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12224PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12224PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12256PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12256PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12256PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12256 32 sourceBlock12256PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12256TwoPairs_eq : ∀ k : Fin 32,
