  have hfirst : (retainedTwoLower 12256, retainedTwoUpper 12256) =
      sourceBlock12256TwoPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)
        (retainedTwoLower 12255, retainedTwoUpper 12255) :=
      retainedTwoPair_succ 12255
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12224TwoPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) (sourceBlock12224TwoPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12256TwoPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12256TwoPairs.getD (k+1) (0,0) =
        sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12256TwoPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedTwoLower j, retainedTwoUpper j))
    (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) retainedTwoPair_succ 12256 32 sourceBlock12256TwoPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12256Midpoints_slice_checked :
    sourceBlock12256Midpoints = (sourceMidpointArray.toList.drop 12256).take 32 := by
  decide +kernel

theorem sourceBlock12256Midpoints_eq_array : ∀ k : Fin 32,
    sourceBlock12256Midpoints.getD k 0 = sourceRoundedMidpoint (12256+k) := by
  intro k
  exact sourceMidpointSlice_lookup 12256 32 sourceBlock12256Midpoints
    sourceBlock12256Midpoints_slice_checked k k.isLt

