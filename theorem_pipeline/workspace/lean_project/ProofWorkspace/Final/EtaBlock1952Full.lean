theorem sourceEtaBatch1952_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates1952 =
      (sourceEtaBatch1952Pairs, sourceEtaRootStates1984) := by
  decide +kernel

theorem sourceEtaRootStates1984_eq : sourceEtaRootStates1984 = etaRootStateTable 400 1984 := by
  have h := congrArg Prod.snd sourceEtaBatch1952_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1952_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch1952_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch1952Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1952+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1952+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch1952_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1952_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 1952)).1 =
    sourceEtaBatch1952Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 1952 32 k hk

def sourceEtaBatch1952Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch1952Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch1952Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch1952Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch1952_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch1952Lower k:ℝ) ≤ etaIntegral (xiGridArgument (1952+k):ℝ) ∧
      etaIntegral (xiGridArgument (1952+k):ℝ) ≤ (sourceEtaBatch1952Upper k:ℝ) := by
  unfold sourceEtaBatch1952Lower sourceEtaBatch1952Upper
  rw [sourceEtaBatch1952_entry k hk]
  exact ratEtaStream_retained_enclosure (1952+k)

theorem sourceEtaBatch1952_width : ∀ k : Fin 32,
    sourceEtaBatch1952Upper k - sourceEtaBatch1952Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

