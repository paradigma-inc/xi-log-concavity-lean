theorem sourceBlock1984PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (1984+k), retainedPiUpper (1984+k)) =
      sourceBlock1984PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 1984, retainedPiUpper 1984) =
      sourceBlock1984PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 1983, retainedPiUpper 1983) :=
      retainedPiPair_succ 1983
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1952PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock1952PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1984PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1984PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1984PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1984 32 sourceBlock1984PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

