theorem sourceBlock8544PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8544+k), retainedPiUpper (8544+k)) =
      sourceBlock8544PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8544, retainedPiUpper 8544) =
      sourceBlock8544PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8543, retainedPiUpper 8543) :=
      retainedPiPair_succ 8543
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8512PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8512PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8544PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8544PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8544PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8544 32 sourceBlock8544PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

