theorem sourceBlock7648PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (7648+k), retainedPiUpper (7648+k)) =
      sourceBlock7648PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 7648, retainedPiUpper 7648) =
      sourceBlock7648PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 7647, retainedPiUpper 7647) :=
      retainedPiPair_succ 7647
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock7616PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock7616PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock7648PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock7648PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock7648PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 7648 32 sourceBlock7648PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

