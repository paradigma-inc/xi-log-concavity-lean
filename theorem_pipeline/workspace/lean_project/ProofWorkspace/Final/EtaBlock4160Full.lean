theorem sourceEtaBatch4160_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates4160 =
      (sourceEtaBatch4160Pairs, sourceEtaRootStates4192) := by
  decide +kernel

theorem sourceEtaRootStates4192_eq : sourceEtaRootStates4192 = etaRootStateTable 400 4192 := by
  have h := congrArg Prod.snd sourceEtaBatch4160_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4160_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch4160_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch4160Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4160+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4160+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch4160_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4160_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 4160)).1 =
    sourceEtaBatch4160Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 4160 32 k hk

def sourceEtaBatch4160Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch4160Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch4160Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch4160Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch4160_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch4160Lower k:ℝ) ≤ etaIntegral (xiGridArgument (4160+k):ℝ) ∧
      etaIntegral (xiGridArgument (4160+k):ℝ) ≤ (sourceEtaBatch4160Upper k:ℝ) := by
  unfold sourceEtaBatch4160Lower sourceEtaBatch4160Upper
  rw [sourceEtaBatch4160_entry k hk]
  exact ratEtaStream_retained_enclosure (4160+k)

theorem sourceEtaBatch4160_width : ∀ k : Fin 32,
    sourceEtaBatch4160Upper k - sourceEtaBatch4160Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

