theorem sourceBlock2432PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (2432+k), retainedPiUpper (2432+k)) =
      sourceBlock2432PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 2432, retainedPiUpper 2432) =
      sourceBlock2432PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 2431, retainedPiUpper 2431) :=
      retainedPiPair_succ 2431
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock2400PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock2400PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock2432PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock2432PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock2432PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 2432 32 sourceBlock2432PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

