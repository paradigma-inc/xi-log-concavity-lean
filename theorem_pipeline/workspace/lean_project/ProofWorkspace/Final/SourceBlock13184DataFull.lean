      sourceBlock13184PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 13183, retainedPiUpper 13183) :=
      retainedPiPair_succ 13183
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13152PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock13152PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock13184PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock13184PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13184PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 13184 32 sourceBlock13184PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

