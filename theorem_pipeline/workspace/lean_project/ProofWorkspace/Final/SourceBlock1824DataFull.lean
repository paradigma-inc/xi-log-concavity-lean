theorem sourceBlock1824PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (1824+k), retainedPiUpper (1824+k)) =
      sourceBlock1824PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 1824, retainedPiUpper 1824) =
      sourceBlock1824PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 1823, retainedPiUpper 1823) :=
      retainedPiPair_succ 1823
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1792PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock1792PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1824PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1824PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1824PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1824 32 sourceBlock1824PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

