    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock7744PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock7744PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock7776PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock7776PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock7776PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 7776 32 sourceBlock7776PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

