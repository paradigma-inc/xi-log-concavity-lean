      retainedPiPair_succ 4063
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4032PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4032PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock4064PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock4064PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4064PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 4064 32 sourceBlock4064PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

