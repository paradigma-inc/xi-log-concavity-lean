theorem originalLowRootSigns_checked (j : Fin 3) :
    (F (originalLowRootLower j:ℂ)).re*(F (originalLowRootUpper j:ℂ)).re<0 := by
  fin_cases j
  · have hl := lowZeroEndpointP0_sign
    have hu := lowZeroEndpointP1_sign
    norm_num [originalLowRootLower,originalLowRootUpper,momentRootUpperEndpoints,
      lowZeroEndpointP0Point,lowZeroSeedP0J0I0K1Point,
      lowZeroEndpointP1Point,lowZeroSeedP1J0I0K1Point] at hl hu ⊢
    exact mul_neg_of_pos_of_neg hl hu
  · have hl := lowZeroEndpointP2_sign
    have hu := lowZeroEndpointP3_sign
    norm_num [originalLowRootLower,originalLowRootUpper,momentRootUpperEndpoints,
      lowZeroEndpointP2Point,lowZeroSeedP2J0I0K1Point,
      lowZeroEndpointP3Point,lowZeroSeedP3J0I0K1Point] at hl hu ⊢
    exact mul_neg_of_neg_of_pos hl hu
  · have hl := lowZeroEndpointP4_sign
    have hu := lowZeroEndpointP5_sign
    norm_num [originalLowRootLower,originalLowRootUpper,momentRootUpperEndpoints,
      lowZeroEndpointP4Point,lowZeroSeedP4J0I0K1Point,
      lowZeroEndpointP5Point,lowZeroSeedP5J0I0K1Point] at hl hu ⊢
    exact mul_neg_of_pos_of_neg hl hu

theorem density_probability_normalization :
    Integrable density ∧ (∫ x : ℝ, density x) = 1 :=
  density_probability_of_original_signs originalLowRootSigns_checked

