/-- Global positivity, curvature, strict log-concavity and PF2 for the actual density. -/
theorem density_global_conclusions :
    (∀ x : ℝ, 0<density x ∧
      0<curvatureJet (density x) (deriv density x) (deriv (deriv density) x)) ∧
    StrictConcaveOn ℝ Set.univ (fun x ↦ Real.log (density x)) ∧
    (∀ x₁ x₂ y₁ y₂ : ℝ, x₁<x₂ → y₁<y₂ →
      0<density (x₁-y₁)*density (x₂-y₂)-density (x₁-y₂)*density (x₂-y₁)) :=
  density_global_conclusions_of_original_signs_and_compact
    originalLowRootSigns_checked sourceDensityCompactEnclosures

/-- All requested conclusions for the original inverse-Fourier density, with no hypotheses.
The two-by-two minor statement is PF2 only; it makes no RH or PF-infinity claim. -/
theorem density_full_conclusions :
    ContDiff ℝ ∞ density ∧
    (∀ x : ℝ, density (-x) = density x) ∧
    Integrable density ∧
    (∫ x : ℝ, density x) = 1 ∧
    (∀ x : ℝ, 0<density x ∧
      0<curvatureJet (density x) (deriv density x) (deriv (deriv density) x)) ∧
    StrictConcaveOn ℝ Set.univ (fun x ↦ Real.log (density x)) ∧
    (∀ x₁ x₂ y₁ y₂ : ℝ, x₁<x₂ → y₁<y₂ →
      0<density (x₁-y₁)*density (x₂-y₂)-density (x₁-y₂)*density (x₂-y₁)) := by
  exact ⟨contDiff_density, density_even,
    density_probability_normalization.1, density_probability_normalization.2,
    density_global_conclusions.1, density_global_conclusions.2.1,
    density_global_conclusions.2.2⟩

