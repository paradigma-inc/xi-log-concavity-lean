def lowZeroCoefficientsP3J3I4K2State (n : ℕ) : ℚ × ℚ := lowZeroCoefficientsP3J3I4K2States.getD n (0,0)
def lowZeroCoefficientsP3J3I4K2Radius (n : ℕ) : ℚ := lowZeroCoefficientsP3J3I4K2Radii.getD n 0

theorem lowZeroCoefficientsP3J3I4K2_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP3J3I4K2Point ((25:ℚ)/2) ((1:ℚ)/2)
      sourcePiMidpoint 2 lowZeroCoefficientsP3J3I4K2State lowZeroCoefficientsP3J3I4K2Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP3J3I4K2_seed_eq : lowZeroCoefficientsP3J3I4K2State 0=lowZeroSeedP3J3I4K2State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP3J3I4K2_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP3J3I4K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP3J3I4K2Point)
        (Real.pi*(2:ℝ)^2) (((25:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J3I4K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP3J3I4K2_seed_eq]
  have he := lowZeroSeedP3J3I4K2_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP3J3I4K2State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP3J3I4K2_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP3J3I4K2State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP3J3I4K2Point)
          (theta48PanelCenter 3 4:ℂ) (Real.pi*(2:ℝ)^2)
          (theta48PanelHalfWidth 3) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP3J3I4K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP3J3I4K2Point)
        (Real.pi*(2:ℝ)^2) (((25:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J3I4K2State 0):ℝ) := lowZeroCoefficientsP3J3I4K2_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP3J3I4K2Point
    ((25:ℚ)/2) ((1:ℚ)/2) 2 lowZeroCoefficientsP3J3I4K2State lowZeroCoefficientsP3J3I4K2Radius
    lowZeroCoefficientsP3J3I4K2_valid (by convert hs using 1 <;> norm_num)
