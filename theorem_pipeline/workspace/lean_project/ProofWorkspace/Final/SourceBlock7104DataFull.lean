  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 7104 32 sourceBlock7104PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

