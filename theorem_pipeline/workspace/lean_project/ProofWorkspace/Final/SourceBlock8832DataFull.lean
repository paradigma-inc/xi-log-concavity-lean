theorem sourceBlock8832PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8832+k), retainedPiUpper (8832+k)) =
      sourceBlock8832PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8832, retainedPiUpper 8832) =
      sourceBlock8832PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8831, retainedPiUpper 8831) :=
      retainedPiPair_succ 8831
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8800PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8800PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8832PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8832PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8832PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8832 32 sourceBlock8832PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

