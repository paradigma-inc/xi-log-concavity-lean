  decide +kernel

theorem sourceEtaRootStates2784_eq : sourceEtaRootStates2784 = etaRootStateTable 400 2784 := by
  have h := congrArg Prod.snd sourceEtaBatch2752_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates2752_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch2752_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch2752Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (2752+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (2752+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch2752_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates2752_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 2752)).1 =
    sourceEtaBatch2752Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 2752 32 k hk

