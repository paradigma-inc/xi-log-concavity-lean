theorem sourceBlock5024PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (5024+k), retainedPiUpper (5024+k)) =
      sourceBlock5024PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 5024, retainedPiUpper 5024) =
      sourceBlock5024PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 5023, retainedPiUpper 5023) :=
      retainedPiPair_succ 5023
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4992PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4992PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock5024PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock5024PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock5024PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 5024 32 sourceBlock5024PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

