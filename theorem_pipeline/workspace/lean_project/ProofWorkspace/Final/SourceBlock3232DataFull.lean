theorem sourceBlock3232PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (3232+k), retainedPiUpper (3232+k)) =
      sourceBlock3232PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 3232, retainedPiUpper 3232) =
      sourceBlock3232PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 3231, retainedPiUpper 3231) :=
      retainedPiPair_succ 3231
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3200PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock3200PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock3232PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock3232PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3232PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 3232 32 sourceBlock3232PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

