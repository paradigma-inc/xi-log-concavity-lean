def lowZeroCoefficientsP2J2I0K4State (n : ℕ) : ℚ × ℚ := lowZeroCoefficientsP2J2I0K4States.getD n (0,0)
def lowZeroCoefficientsP2J2I0K4Radius (n : ℕ) : ℚ := lowZeroCoefficientsP2J2I0K4Radii.getD n 0

theorem lowZeroCoefficientsP2J2I0K4_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP2J2I0K4Point ((17:ℚ)/4) ((1:ℚ)/4)
      sourcePiMidpoint 4 lowZeroCoefficientsP2J2I0K4State lowZeroCoefficientsP2J2I0K4Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP2J2I0K4_seed_eq : lowZeroCoefficientsP2J2I0K4State 0=lowZeroSeedP2J2I0K4State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP2J2I0K4_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP2J2I0K4State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J2I0K4Point)
        (Real.pi*(4:ℝ)^2) (((17:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J2I0K4State 0):ℝ) := by
  rw [lowZeroCoefficientsP2J2I0K4_seed_eq]
  have he := lowZeroSeedP2J2I0K4_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP2J2I0K4State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP2J2I0K4_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP2J2I0K4State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP2J2I0K4Point)
          (theta48PanelCenter 2 0:ℂ) (Real.pi*(4:ℝ)^2)
          (theta48PanelHalfWidth 2) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP2J2I0K4State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J2I0K4Point)
        (Real.pi*(4:ℝ)^2) (((17:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J2I0K4State 0):ℝ) := lowZeroCoefficientsP2J2I0K4_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP2J2I0K4Point
    ((17:ℚ)/4) ((1:ℚ)/4) 4 lowZeroCoefficientsP2J2I0K4State lowZeroCoefficientsP2J2I0K4Radius
    lowZeroCoefficientsP2J2I0K4_valid (by convert hs using 1 <;> norm_num)
