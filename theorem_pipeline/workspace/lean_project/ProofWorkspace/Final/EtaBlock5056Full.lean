theorem sourceEtaBatch5056_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates5056 =
      (sourceEtaBatch5056Pairs, sourceEtaRootStates5088) := by
  decide +kernel

theorem sourceEtaRootStates5088_eq : sourceEtaRootStates5088 = etaRootStateTable 400 5088 := by
  have h := congrArg Prod.snd sourceEtaBatch5056_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates5056_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch5056_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch5056Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (5056+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (5056+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch5056_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates5056_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 5056)).1 =
    sourceEtaBatch5056Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 5056 32 k hk

def sourceEtaBatch5056Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch5056Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch5056Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch5056Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch5056_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch5056Lower k:ℝ) ≤ etaIntegral (xiGridArgument (5056+k):ℝ) ∧
      etaIntegral (xiGridArgument (5056+k):ℝ) ≤ (sourceEtaBatch5056Upper k:ℝ) := by
  unfold sourceEtaBatch5056Lower sourceEtaBatch5056Upper
  rw [sourceEtaBatch5056_entry k hk]
  exact ratEtaStream_retained_enclosure (5056+k)

theorem sourceEtaBatch5056_width : ∀ k : Fin 32,
