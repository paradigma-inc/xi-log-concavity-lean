      sourceBlock11296PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 11295, retainedPiUpper 11295) :=
      retainedPiPair_succ 11295
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11264PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11264PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11296PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11296PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11296PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11296 32 sourceBlock11296PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

