    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates3584 =
      (sourceEtaBatch3584Pairs, sourceEtaRootStates3616) := by
  decide +kernel

theorem sourceEtaRootStates3616_eq : sourceEtaRootStates3616 = etaRootStateTable 400 3616 := by
  have h := congrArg Prod.snd sourceEtaBatch3584_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates3584_eq,
    etaStreamBatch_final_canonical] at h
