theorem sourceEtaBatch3584_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch3584Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (3584+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (3584+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch3584_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates3584_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 3584)).1 =
    sourceEtaBatch3584Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 3584 32 k hk

def sourceEtaBatch3584Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch3584Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch3584Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch3584Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch3584_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch3584Lower k:ℝ) ≤ etaIntegral (xiGridArgument (3584+k):ℝ) ∧
      etaIntegral (xiGridArgument (3584+k):ℝ) ≤ (sourceEtaBatch3584Upper k:ℝ) := by
  unfold sourceEtaBatch3584Lower sourceEtaBatch3584Upper
  rw [sourceEtaBatch3584_entry k hk]
