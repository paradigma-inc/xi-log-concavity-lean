theorem sourceBlock12032PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12032+k), retainedPiUpper (12032+k)) =
      sourceBlock12032PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12032, retainedPiUpper 12032) =
      sourceBlock12032PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12031, retainedPiUpper 12031) :=
      retainedPiPair_succ 12031
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12000PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12000PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12032PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12032PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12032PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12032 32 sourceBlock12032PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

