    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10176 32 sourceBlock10176PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

