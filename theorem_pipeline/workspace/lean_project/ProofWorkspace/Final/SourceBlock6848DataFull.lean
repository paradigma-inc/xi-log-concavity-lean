theorem sourceBlock6848PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (6848+k), retainedPiUpper (6848+k)) =
      sourceBlock6848PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 6848, retainedPiUpper 6848) =
      sourceBlock6848PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 6847, retainedPiUpper 6847) :=
      retainedPiPair_succ 6847
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6816PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock6816PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock6848PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock6848PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6848PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 6848 32 sourceBlock6848PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

