theorem sourceEtaBatch1216_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates1216 =
      (sourceEtaBatch1216Pairs, sourceEtaRootStates1248) := by
  decide +kernel

theorem sourceEtaRootStates1248_eq : sourceEtaRootStates1248 = etaRootStateTable 400 1248 := by
  have h := congrArg Prod.snd sourceEtaBatch1216_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1216_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch1216_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch1216Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1216+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1216+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch1216_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1216_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 1216)).1 =
    sourceEtaBatch1216Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 1216 32 k hk

def sourceEtaBatch1216Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch1216Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch1216Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch1216Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch1216_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch1216Lower k:ℝ) ≤ etaIntegral (xiGridArgument (1216+k):ℝ) ∧
      etaIntegral (xiGridArgument (1216+k):ℝ) ≤ (sourceEtaBatch1216Upper k:ℝ) := by
  unfold sourceEtaBatch1216Lower sourceEtaBatch1216Upper
  rw [sourceEtaBatch1216_entry k hk]
  exact ratEtaStream_retained_enclosure (1216+k)

theorem sourceEtaBatch1216_width : ∀ k : Fin 32,
    sourceEtaBatch1216Upper k - sourceEtaBatch1216Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

