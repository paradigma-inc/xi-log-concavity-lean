theorem sourceEtaBatch1856_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates1856 =
      (sourceEtaBatch1856Pairs, sourceEtaRootStates1888) := by
  decide +kernel

theorem sourceEtaRootStates1888_eq : sourceEtaRootStates1888 = etaRootStateTable 400 1888 := by
  have h := congrArg Prod.snd sourceEtaBatch1856_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1856_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch1856_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch1856Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1856+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1856+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch1856_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1856_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 1856)).1 =
    sourceEtaBatch1856Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 1856 32 k hk

def sourceEtaBatch1856Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch1856Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch1856Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch1856Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch1856_actual_enclosure (k : ℕ) (hk : k < 32) :
