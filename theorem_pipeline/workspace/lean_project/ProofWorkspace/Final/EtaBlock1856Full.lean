      etaIntegral (xiGridArgument (1856+k):ℝ) ≤ (sourceEtaBatch1856Upper k:ℝ) := by
  unfold sourceEtaBatch1856Lower sourceEtaBatch1856Upper
  rw [sourceEtaBatch1856_entry k hk]
