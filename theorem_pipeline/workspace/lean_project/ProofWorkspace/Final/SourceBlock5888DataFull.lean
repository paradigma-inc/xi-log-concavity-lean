theorem sourceBlock5888PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (5888+k), retainedPiUpper (5888+k)) =
      sourceBlock5888PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 5888, retainedPiUpper 5888) =
      sourceBlock5888PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 5887, retainedPiUpper 5887) :=
      retainedPiPair_succ 5887
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock5856PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock5856PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock5888PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock5888PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock5888PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 5888 32 sourceBlock5888PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

