    sourceEtaBatch4352Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4352+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4352+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch4352_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4352_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 4352)).1 =
    sourceEtaBatch4352Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 4352 32 k hk

def sourceEtaBatch4352Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch4352Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch4352Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch4352Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch4352_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch4352Lower k:ℝ) ≤ etaIntegral (xiGridArgument (4352+k):ℝ) ∧
      etaIntegral (xiGridArgument (4352+k):ℝ) ≤ (sourceEtaBatch4352Upper k:ℝ) := by
  unfold sourceEtaBatch4352Lower sourceEtaBatch4352Upper
  rw [sourceEtaBatch4352_entry k hk]
  exact ratEtaStream_retained_enclosure (4352+k)

theorem sourceEtaBatch4352_width : ∀ k : Fin 32,
    sourceEtaBatch4352Upper k - sourceEtaBatch4352Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
