theorem sourceEtaBatch576_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates576 =
      (sourceEtaBatch576Pairs, sourceEtaRootStates608) := by
  decide +kernel

theorem sourceEtaRootStates608_eq : sourceEtaRootStates608 = etaRootStateTable 400 608 := by
  have h := congrArg Prod.snd sourceEtaBatch576_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates576_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch576_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch576Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (576+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (576+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch576_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates576_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 576)).1 =
    sourceEtaBatch576Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 576 32 k hk

def sourceEtaBatch576Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch576Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch576Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch576Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch576_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch576Lower k:ℝ) ≤ etaIntegral (xiGridArgument (576+k):ℝ) ∧
      etaIntegral (xiGridArgument (576+k):ℝ) ≤ (sourceEtaBatch576Upper k:ℝ) := by
  unfold sourceEtaBatch576Lower sourceEtaBatch576Upper
  rw [sourceEtaBatch576_entry k hk]
  exact ratEtaStream_retained_enclosure (576+k)

theorem sourceEtaBatch576_width : ∀ k : Fin 32,
    sourceEtaBatch576Upper k - sourceEtaBatch576Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
