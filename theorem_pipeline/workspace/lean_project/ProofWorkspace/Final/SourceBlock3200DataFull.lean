theorem sourceBlock3200PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (3200+k), retainedPiUpper (3200+k)) =
      sourceBlock3200PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 3200, retainedPiUpper 3200) =
      sourceBlock3200PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 3199, retainedPiUpper 3199) :=
      retainedPiPair_succ 3199
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3168PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock3168PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock3200PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock3200PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3200PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 3200 32 sourceBlock3200PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

