theorem sourceEtaBatch2656_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates2656 =
      (sourceEtaBatch2656Pairs, sourceEtaRootStates2688) := by
  decide +kernel

theorem sourceEtaRootStates2688_eq : sourceEtaRootStates2688 = etaRootStateTable 400 2688 := by
  have h := congrArg Prod.snd sourceEtaBatch2656_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates2656_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch2656_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch2656Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (2656+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (2656+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch2656_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates2656_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 2656)).1 =
    sourceEtaBatch2656Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 2656 32 k hk

def sourceEtaBatch2656Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch2656Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch2656Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch2656Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch2656_actual_enclosure (k : ℕ) (hk : k < 32) :
