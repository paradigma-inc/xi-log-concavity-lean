      etaIntegral (xiGridArgument (2656+k):ℝ) ≤ (sourceEtaBatch2656Upper k:ℝ) := by
  unfold sourceEtaBatch2656Lower sourceEtaBatch2656Upper
  rw [sourceEtaBatch2656_entry k hk]
