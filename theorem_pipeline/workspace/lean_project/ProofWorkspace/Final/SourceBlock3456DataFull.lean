theorem sourceBlock3456PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (3456+k), retainedPiUpper (3456+k)) =
      sourceBlock3456PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 3456, retainedPiUpper 3456) =
      sourceBlock3456PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 3455, retainedPiUpper 3455) :=
      retainedPiPair_succ 3455
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3424PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock3424PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock3456PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock3456PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3456PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 3456 32 sourceBlock3456PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

