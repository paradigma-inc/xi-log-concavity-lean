theorem sourceEtaBatch3488_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates3488 =
      (sourceEtaBatch3488Pairs, sourceEtaRootStates3520) := by
  decide +kernel

theorem sourceEtaRootStates3520_eq : sourceEtaRootStates3520 = etaRootStateTable 400 3520 := by
  have h := congrArg Prod.snd sourceEtaBatch3488_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates3488_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch3488_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch3488Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (3488+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (3488+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch3488_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates3488_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 3488)).1 =
    sourceEtaBatch3488Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 3488 32 k hk

