theorem sourceBlock8512PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8512+k), retainedPiUpper (8512+k)) =
      sourceBlock8512PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8512, retainedPiUpper 8512) =
      sourceBlock8512PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8511, retainedPiUpper 8511) :=
      retainedPiPair_succ 8511
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8480PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8480PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8512PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8512PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8512PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8512 32 sourceBlock8512PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

