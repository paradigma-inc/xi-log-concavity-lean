theorem sourceBlock13312PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (13312+k), retainedPiUpper (13312+k)) =
      sourceBlock13312PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 13312, retainedPiUpper 13312) =
      sourceBlock13312PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 13311, retainedPiUpper 13311) :=
      retainedPiPair_succ 13311
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13280PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock13280PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock13312PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock13312PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13312PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 13312 32 sourceBlock13312PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

