theorem sourceEtaBatch1280_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates1280 =
      (sourceEtaBatch1280Pairs, sourceEtaRootStates1312) := by
  decide +kernel

theorem sourceEtaRootStates1312_eq : sourceEtaRootStates1312 = etaRootStateTable 400 1312 := by
  have h := congrArg Prod.snd sourceEtaBatch1280_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1280_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch1280_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch1280Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1280+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1280+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch1280_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1280_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 1280)).1 =
    sourceEtaBatch1280Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 1280 32 k hk

def sourceEtaBatch1280Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch1280Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch1280Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch1280Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch1280_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch1280Lower k:ℝ) ≤ etaIntegral (xiGridArgument (1280+k):ℝ) ∧
      etaIntegral (xiGridArgument (1280+k):ℝ) ≤ (sourceEtaBatch1280Upper k:ℝ) := by
  unfold sourceEtaBatch1280Lower sourceEtaBatch1280Upper
  rw [sourceEtaBatch1280_entry k hk]
  exact ratEtaStream_retained_enclosure (1280+k)

theorem sourceEtaBatch1280_width : ∀ k : Fin 32,
    sourceEtaBatch1280Upper k - sourceEtaBatch1280Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
