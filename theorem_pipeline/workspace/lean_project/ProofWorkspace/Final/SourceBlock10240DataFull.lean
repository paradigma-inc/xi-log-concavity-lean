theorem sourceBlock10240PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10240+k), retainedPiUpper (10240+k)) =
      sourceBlock10240PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10240, retainedPiUpper 10240) =
      sourceBlock10240PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10239, retainedPiUpper 10239) :=
      retainedPiPair_succ 10239
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10208PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10208PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10240PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10240PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10240PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10240 32 sourceBlock10240PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

