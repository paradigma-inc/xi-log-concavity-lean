theorem sourceEtaBatch1248_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates1248 =
      (sourceEtaBatch1248Pairs, sourceEtaRootStates1280) := by
  decide +kernel

theorem sourceEtaRootStates1280_eq : sourceEtaRootStates1280 = etaRootStateTable 400 1280 := by
  have h := congrArg Prod.snd sourceEtaBatch1248_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1248_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch1248_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch1248Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1248+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1248+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch1248_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1248_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 1248)).1 =
    sourceEtaBatch1248Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 1248 32 k hk

def sourceEtaBatch1248Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch1248Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch1248Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch1248Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch1248_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch1248Lower k:ℝ) ≤ etaIntegral (xiGridArgument (1248+k):ℝ) ∧
      etaIntegral (xiGridArgument (1248+k):ℝ) ≤ (sourceEtaBatch1248Upper k:ℝ) := by
  unfold sourceEtaBatch1248Lower sourceEtaBatch1248Upper
  rw [sourceEtaBatch1248_entry k hk]
  exact ratEtaStream_retained_enclosure (1248+k)

theorem sourceEtaBatch1248_width : ∀ k : Fin 32,
    sourceEtaBatch1248Upper k - sourceEtaBatch1248Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
