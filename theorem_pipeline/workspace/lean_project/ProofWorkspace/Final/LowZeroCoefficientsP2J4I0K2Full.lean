def lowZeroCoefficientsP2J4I0K2State (n : ℕ) : ℚ × ℚ := lowZeroCoefficientsP2J4I0K2States.getD n (0,0)
def lowZeroCoefficientsP2J4I0K2Radius (n : ℕ) : ℚ := lowZeroCoefficientsP2J4I0K2Radii.getD n 0

theorem lowZeroCoefficientsP2J4I0K2_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP2J4I0K2Point ((17:ℚ)/1) ((1:ℚ)/1)
      sourcePiMidpoint 2 lowZeroCoefficientsP2J4I0K2State lowZeroCoefficientsP2J4I0K2Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP2J4I0K2_seed_eq : lowZeroCoefficientsP2J4I0K2State 0=lowZeroSeedP2J4I0K2State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP2J4I0K2_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP2J4I0K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J4I0K2Point)
        (Real.pi*(2:ℝ)^2) (((17:ℚ)/1):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J4I0K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP2J4I0K2_seed_eq]
  have he := lowZeroSeedP2J4I0K2_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP2J4I0K2State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP2J4I0K2_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP2J4I0K2State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP2J4I0K2Point)
          (theta48PanelCenter 4 0:ℂ) (Real.pi*(2:ℝ)^2)
          (theta48PanelHalfWidth 4) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP2J4I0K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J4I0K2Point)
        (Real.pi*(2:ℝ)^2) (((17:ℚ)/1):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J4I0K2State 0):ℝ) := lowZeroCoefficientsP2J4I0K2_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP2J4I0K2Point
    ((17:ℚ)/1) ((1:ℚ)/1) 2 lowZeroCoefficientsP2J4I0K2State lowZeroCoefficientsP2J4I0K2Radius
    lowZeroCoefficientsP2J4I0K2_valid (by convert hs using 1 <;> norm_num)
