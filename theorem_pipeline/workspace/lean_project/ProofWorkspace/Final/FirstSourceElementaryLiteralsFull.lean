set_option maxHeartbeats 100000000
namespace ReciprocalXi

def nodePiCandidate (k : ℕ) : ℚ × ℚ :=
  let q := -xiGridArgument k / 2
  let lo := ratRoundLower (min (q*roundedLogPiLower400B180) (q*roundedLogPiUpper400B180)) (10^180)
  let hi := ratRoundUpper (max (q*roundedLogPiLower400B180) (q*roundedLogPiUpper400B180)) (10^180)
  (ratExpScanIntegerLower lo 256 128 (10^180),
    ratExpScanIntegerUpper hi 256 128 (10^180))

theorem nodePiCandidate_eq (k : ℕ) :
    nodePiCandidate k =
      (ratPiPowerFastLower (-xiGridArgument k / 2) 400 256 128 (10^180),
        ratPiPowerFastUpper (-xiGridArgument k / 2) 400 256 128 (10^180)) := by
  unfold ratPiPowerFastLower ratPiPowerFastUpper
    ratPiPowerLogFastLower ratPiPowerLogFastUpper
  rw [roundedLogPiLower400B180_eq, roundedLogPiUpper400B180_eq]
  unfold nodePiCandidate
  dsimp only
  rw [ratExpScanIntegerLower_eq _ _ _ _ (by norm_num),
    ratExpScanIntegerUpper_eq _ _ _ _ (by norm_num)]


