        (retainedPiLower 9087, retainedPiUpper 9087) :=
      retainedPiPair_succ 9087
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock9056PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock9056PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock9088PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock9088PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock9088PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 9088 32 sourceBlock9088PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

