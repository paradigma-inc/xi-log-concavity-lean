theorem gammaEulerWeightChunks480_eq :
    gammaEulerWeightChunks480.flatten = gammaEulerWeights480 := by
  decide +kernel

def gammaEtaLowerChunkSum (k : ℕ) : ℤ :=
  intEtaChunkSum (fun j w => intEtaTermLower w j k (10^180)) 0 gammaEulerWeightChunks480

def gammaEtaUpperChunkSum (k : ℕ) : ℤ :=
  intEtaChunkSum (fun j w => intEtaTermUpper w j k (10^180)) 0 gammaEulerWeightChunks480

theorem gammaEtaLowerChunkSum_eq (k : ℕ) : gammaEtaLowerChunkSum k = gammaEtaLowerSum k := by
  unfold gammaEtaLowerChunkSum
  rw [intEtaChunkSum_eq, gammaEulerWeightChunks480_eq]
  rfl

theorem gammaEtaUpperChunkSum_eq (k : ℕ) : gammaEtaUpperChunkSum k = gammaEtaUpperSum k := by
  unfold gammaEtaUpperChunkSum
  rw [intEtaChunkSum_eq, gammaEulerWeightChunks480_eq]
  rfl

def gammaZetaChunkPair (k : ℕ) : ℚ × ℚ :=
  (ratRoundLower (ratZetaNatFactor k * ((gammaEtaLowerChunkSum k:ℚ)/(10^180:ℕ))) (10^180),
    ratRoundUpper (ratZetaNatFactor k * ((gammaEtaUpperChunkSum k:ℚ)/(10^180:ℕ)) + 2/(2:ℚ)^480) (10^180))

theorem gammaZetaChunkPair_eq (k : ℕ) :
    gammaZetaChunkPair k = ratZetaPairFromWeights gammaEulerWeights480 480 k (10^180) := by
  unfold gammaZetaChunkPair
  rw [gammaEtaLowerChunkSum_eq, gammaEtaUpperChunkSum_eq]
  rfl

