theorem sourceBlock8288PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8288+k), retainedPiUpper (8288+k)) =
      sourceBlock8288PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8288, retainedPiUpper 8288) =
      sourceBlock8288PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8287, retainedPiUpper 8287) :=
      retainedPiPair_succ 8287
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8256PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8256PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8288PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8288PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8288PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8288 32 sourceBlock8288PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

