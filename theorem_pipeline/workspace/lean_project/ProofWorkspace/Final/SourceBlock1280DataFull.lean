      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock1248PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1280PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1280PiPairs.getD (k+1) (0,0) =
