    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1280 32 sourceBlock1280PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

