theorem sourceBlock8160PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8160+k), retainedPiUpper (8160+k)) =
      sourceBlock8160PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8160, retainedPiUpper 8160) =
      sourceBlock8160PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8159, retainedPiUpper 8159) :=
      retainedPiPair_succ 8159
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8128PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8128PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8160PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8160PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8160PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8160 32 sourceBlock8160PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

