theorem sourceEtaBatch0_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch0Lower k:ℝ) ≤ etaIntegral (xiGridArgument k:ℝ) ∧
      etaIntegral (xiGridArgument k:ℝ) ≤ (sourceEtaBatch0Upper k:ℝ) := by
  unfold sourceEtaBatch0Lower sourceEtaBatch0Upper
  rw [sourceEtaBatch0_entry k hk]
  exact ratEtaStream_retained_enclosure k

set_option maxRecDepth 32768 in
theorem sourceEtaBatch0_width : ∀ k : Fin 32,
    sourceEtaBatch0Upper k - sourceEtaBatch0Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
