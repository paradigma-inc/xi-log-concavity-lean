          (theta48PanelHalfWidth 2) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP2J2I5K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J2I5K3Point)
        (Real.pi*(3:ℝ)^2) (((27:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J2I5K3State 0):ℝ) := lowZeroCoefficientsP2J2I5K3_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP2J2I5K3Point
    ((27:ℚ)/4) ((1:ℚ)/4) 3 lowZeroCoefficientsP2J2I5K3State lowZeroCoefficientsP2J2I5K3Radius
