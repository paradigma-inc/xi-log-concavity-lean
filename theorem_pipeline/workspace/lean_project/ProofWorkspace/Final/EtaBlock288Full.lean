theorem sourceEtaBatch288_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch288Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (288+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (288+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch288_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates288_eq] at h
