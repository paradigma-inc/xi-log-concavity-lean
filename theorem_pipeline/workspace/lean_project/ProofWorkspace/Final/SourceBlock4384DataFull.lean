theorem sourceBlock4384PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (4384+k), retainedPiUpper (4384+k)) =
      sourceBlock4384PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 4384, retainedPiUpper 4384) =
      sourceBlock4384PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 4383, retainedPiUpper 4383) :=
      retainedPiPair_succ 4383
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4352PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4352PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock4384PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock4384PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4384PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 4384 32 sourceBlock4384PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

