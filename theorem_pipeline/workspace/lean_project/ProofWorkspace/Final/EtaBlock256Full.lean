theorem sourceEtaBatch256_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates256 =
      (sourceEtaBatch256Pairs, sourceEtaRootStates288) := by
  decide +kernel

theorem sourceEtaRootStates288_eq : sourceEtaRootStates288 = etaRootStateTable 400 288 := by
  have h := congrArg Prod.snd sourceEtaBatch256_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates256_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch256_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch256Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (256+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (256+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch256_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates256_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 256)).1 =
    sourceEtaBatch256Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 256 32 k hk

def sourceEtaBatch256Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch256Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch256Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch256Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch256_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch256Lower k:ℝ) ≤ etaIntegral (xiGridArgument (256+k):ℝ) ∧
      etaIntegral (xiGridArgument (256+k):ℝ) ≤ (sourceEtaBatch256Upper k:ℝ) := by
  unfold sourceEtaBatch256Lower sourceEtaBatch256Upper
  rw [sourceEtaBatch256_entry k hk]
  exact ratEtaStream_retained_enclosure (256+k)

theorem sourceEtaBatch256_width : ∀ k : Fin 32,
    sourceEtaBatch256Upper k - sourceEtaBatch256Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

