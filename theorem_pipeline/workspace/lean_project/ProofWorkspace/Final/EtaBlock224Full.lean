theorem sourceEtaBatch224_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates224 =
      (sourceEtaBatch224Pairs, sourceEtaRootStates256) := by
  decide +kernel

theorem sourceEtaRootStates256_eq : sourceEtaRootStates256 = etaRootStateTable 400 256 := by
  have h := congrArg Prod.snd sourceEtaBatch224_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates224_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch224_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch224Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (224+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (224+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch224_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates224_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 224)).1 =
    sourceEtaBatch224Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 224 32 k hk

def sourceEtaBatch224Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch224Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch224Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch224Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch224_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch224Lower k:ℝ) ≤ etaIntegral (xiGridArgument (224+k):ℝ) ∧
      etaIntegral (xiGridArgument (224+k):ℝ) ≤ (sourceEtaBatch224Upper k:ℝ) := by
  unfold sourceEtaBatch224Lower sourceEtaBatch224Upper
  rw [sourceEtaBatch224_entry k hk]
  exact ratEtaStream_retained_enclosure (224+k)

theorem sourceEtaBatch224_width : ∀ k : Fin 32,
    sourceEtaBatch224Upper k - sourceEtaBatch224Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

