    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 11839, retainedPiUpper 11839) :=
      retainedPiPair_succ 11839
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11808PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11808PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11840PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11840PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11840PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11840 32 sourceBlock11840PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

