      retainedPiPair_succ 6303
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6272PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock6272PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock6304PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock6304PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6304PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 6304 32 sourceBlock6304PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

