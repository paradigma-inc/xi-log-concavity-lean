      retainedPiPair_succ 11583
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11552PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11552PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11584PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11584PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11584PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11584 32 sourceBlock11584PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

