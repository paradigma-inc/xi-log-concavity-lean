theorem sourceBlock12544PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12544+k), retainedPiUpper (12544+k)) =
      sourceBlock12544PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12544, retainedPiUpper 12544) =
      sourceBlock12544PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12543, retainedPiUpper 12543) :=
      retainedPiPair_succ 12543
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12512PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12512PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12544PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12544PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12544PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12544 32 sourceBlock12544PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

