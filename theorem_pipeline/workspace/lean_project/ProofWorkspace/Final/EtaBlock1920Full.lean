theorem sourceEtaBatch1920_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates1920 =
      (sourceEtaBatch1920Pairs, sourceEtaRootStates1952) := by
  decide +kernel

theorem sourceEtaRootStates1952_eq : sourceEtaRootStates1952 = etaRootStateTable 400 1952 := by
  have h := congrArg Prod.snd sourceEtaBatch1920_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1920_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch1920_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch1920Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1920+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1920+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch1920_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1920_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 1920)).1 =
    sourceEtaBatch1920Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 1920 32 k hk

def sourceEtaBatch1920Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch1920Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch1920Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch1920Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch1920_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch1920Lower k:ℝ) ≤ etaIntegral (xiGridArgument (1920+k):ℝ) ∧
      etaIntegral (xiGridArgument (1920+k):ℝ) ≤ (sourceEtaBatch1920Upper k:ℝ) := by
  unfold sourceEtaBatch1920Lower sourceEtaBatch1920Upper
  rw [sourceEtaBatch1920_entry k hk]
  exact ratEtaStream_retained_enclosure (1920+k)

theorem sourceEtaBatch1920_width : ∀ k : Fin 32,
    sourceEtaBatch1920Upper k - sourceEtaBatch1920Lower k < 1/(10:ℚ)^120 := by
