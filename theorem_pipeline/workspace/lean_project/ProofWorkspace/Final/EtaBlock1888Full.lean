theorem sourceEtaBatch1888_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates1888 =
      (sourceEtaBatch1888Pairs, sourceEtaRootStates1920) := by
  decide +kernel

theorem sourceEtaRootStates1920_eq : sourceEtaRootStates1920 = etaRootStateTable 400 1920 := by
  have h := congrArg Prod.snd sourceEtaBatch1888_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1888_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch1888_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch1888Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1888+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (1888+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch1888_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates1888_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 1888)).1 =
    sourceEtaBatch1888Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 1888 32 k hk

def sourceEtaBatch1888Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch1888Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch1888Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch1888Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch1888_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch1888Lower k:ℝ) ≤ etaIntegral (xiGridArgument (1888+k):ℝ) ∧
      etaIntegral (xiGridArgument (1888+k):ℝ) ≤ (sourceEtaBatch1888Upper k:ℝ) := by
  unfold sourceEtaBatch1888Lower sourceEtaBatch1888Upper
  rw [sourceEtaBatch1888_entry k hk]
  exact ratEtaStream_retained_enclosure (1888+k)

theorem sourceEtaBatch1888_width : ∀ k : Fin 32,
    sourceEtaBatch1888Upper k - sourceEtaBatch1888Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

