theorem lowZeroCoefficientsP1J2I0K4_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP1J2I0K4Point ((17:ℚ)/4) ((1:ℚ)/4)
      sourcePiMidpoint 4 lowZeroCoefficientsP1J2I0K4State lowZeroCoefficientsP1J2I0K4Radius := by
