theorem lowZeroCoefficientsP1J2I0K4_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP1J2I0K4State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP1J2I0K4Point)
        (Real.pi*(4:ℝ)^2) (((17:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP1J2I0K4State 0):ℝ) := by
  rw [lowZeroCoefficientsP1J2I0K4_seed_eq]
  have he := lowZeroSeedP1J2I0K4_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP1J2I0K4State 16))
