theorem sourceBlock10112PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10112+k), retainedPiUpper (10112+k)) =
      sourceBlock10112PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10112, retainedPiUpper 10112) =
      sourceBlock10112PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10111, retainedPiUpper 10111) :=
      retainedPiPair_succ 10111
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10080PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10080PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10112PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10112PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10112PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10112 32 sourceBlock10112PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

