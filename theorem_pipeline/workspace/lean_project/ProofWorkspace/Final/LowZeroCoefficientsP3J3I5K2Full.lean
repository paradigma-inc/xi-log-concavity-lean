theorem lowZeroCoefficientsP3J3I5K2_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP3J3I5K2Point ((27:ℚ)/2) ((1:ℚ)/2)
      sourcePiMidpoint 2 lowZeroCoefficientsP3J3I5K2State lowZeroCoefficientsP3J3I5K2Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP3J3I5K2_seed_eq : lowZeroCoefficientsP3J3I5K2State 0=lowZeroSeedP3J3I5K2State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP3J3I5K2_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP3J3I5K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP3J3I5K2Point)
        (Real.pi*(2:ℝ)^2) (((27:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J3I5K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP3J3I5K2_seed_eq]
  have he := lowZeroSeedP3J3I5K2_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP3J3I5K2State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

