  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP3J3I5K2Point
    ((27:ℚ)/2) ((1:ℚ)/2) 2 lowZeroCoefficientsP3J3I5K2State lowZeroCoefficientsP3J3I5K2Radius
