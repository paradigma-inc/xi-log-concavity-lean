    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8735, retainedPiUpper 8735) :=
      retainedPiPair_succ 8735
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8704PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8704PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8736PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8736PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8736PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8736 32 sourceBlock8736PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

