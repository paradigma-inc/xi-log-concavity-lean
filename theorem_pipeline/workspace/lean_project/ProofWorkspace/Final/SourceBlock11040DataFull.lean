theorem sourceBlock11040PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (11040+k), retainedPiUpper (11040+k)) =
      sourceBlock11040PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 11040, retainedPiUpper 11040) =
      sourceBlock11040PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 11039, retainedPiUpper 11039) :=
      retainedPiPair_succ 11039
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11008PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11008PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11040PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11040PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11040PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11040 32 sourceBlock11040PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

