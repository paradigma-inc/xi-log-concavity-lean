theorem sourceBlock4800PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (4800+k), retainedPiUpper (4800+k)) =
      sourceBlock4800PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 4800, retainedPiUpper 4800) =
      sourceBlock4800PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 4799, retainedPiUpper 4799) :=
      retainedPiPair_succ 4799
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4768PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4768PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock4800PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock4800PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4800PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 4800 32 sourceBlock4800PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

