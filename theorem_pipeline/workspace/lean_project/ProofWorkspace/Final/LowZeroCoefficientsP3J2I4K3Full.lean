def lowZeroCoefficientsP3J2I4K3State (n : ℕ) : ℚ × ℚ := lowZeroCoefficientsP3J2I4K3States.getD n (0,0)
def lowZeroCoefficientsP3J2I4K3Radius (n : ℕ) : ℚ := lowZeroCoefficientsP3J2I4K3Radii.getD n 0

theorem lowZeroCoefficientsP3J2I4K3_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP3J2I4K3Point ((25:ℚ)/4) ((1:ℚ)/4)
      sourcePiMidpoint 3 lowZeroCoefficientsP3J2I4K3State lowZeroCoefficientsP3J2I4K3Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP3J2I4K3_seed_eq : lowZeroCoefficientsP3J2I4K3State 0=lowZeroSeedP3J2I4K3State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP3J2I4K3_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP3J2I4K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP3J2I4K3Point)
        (Real.pi*(3:ℝ)^2) (((25:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J2I4K3State 0):ℝ) := by
  rw [lowZeroCoefficientsP3J2I4K3_seed_eq]
  have he := lowZeroSeedP3J2I4K3_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP3J2I4K3State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP3J2I4K3_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP3J2I4K3State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP3J2I4K3Point)
          (theta48PanelCenter 2 4:ℂ) (Real.pi*(3:ℝ)^2)
          (theta48PanelHalfWidth 2) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP3J2I4K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP3J2I4K3Point)
        (Real.pi*(3:ℝ)^2) (((25:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J2I4K3State 0):ℝ) := lowZeroCoefficientsP3J2I4K3_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP3J2I4K3Point
    ((25:ℚ)/4) ((1:ℚ)/4) 3 lowZeroCoefficientsP3J2I4K3State lowZeroCoefficientsP3J2I4K3Radius
    lowZeroCoefficientsP3J2I4K3_valid (by convert hs using 1 <;> norm_num)
  convert he using 1 <;> norm_num [theta48PanelCenter,theta48PanelHalfWidth]

