  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 7584 32 sourceBlock7584PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

