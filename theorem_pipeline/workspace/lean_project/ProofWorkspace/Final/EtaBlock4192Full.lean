theorem sourceEtaBatch4192_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates4192 =
      (sourceEtaBatch4192Pairs, sourceEtaRootStates4224) := by
  decide +kernel

theorem sourceEtaRootStates4224_eq : sourceEtaRootStates4224 = etaRootStateTable 400 4224 := by
  have h := congrArg Prod.snd sourceEtaBatch4192_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4192_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch4192_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch4192Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4192+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4192+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch4192_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4192_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 4192)).1 =
    sourceEtaBatch4192Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 4192 32 k hk

def sourceEtaBatch4192Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch4192Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch4192Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch4192Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
