def momentCoefficientWeight (j : Fin 33) : ℚ := momentCoefficientWeights.getD j 0
def momentCoefficientWeightMass : ℚ := ∑ j : Fin 33, |momentCoefficientWeight j|

theorem momentCoefficientWeights_exact : ∀ m : Fin 33,
    (∑ j : Fin 33, momentCoefficientWeight j*(momentSampleNode j)^(m:ℕ))=
      if (m:ℕ)=16 then 1 else 0 := by
  intro m
  fin_cases m
  all_goals decide +kernel

theorem momentCoefficientWeightMass_bound : momentCoefficientWeightMass<3*10^29 := by
  decide +kernel

def momentOneUpper : ℚ :=
  (momentLogSample 1+1/(10:ℚ)^118)/(1/1600)+
    70*(1/1600)/(2*49*(1-(1/1600)/49))

theorem momentOneUpper_bound : momentOneUpper<1/160 := by decide +kernel

def momentTwoUpper : ℚ :=
  (4*momentLogSample 1-momentLogSample 2+5/(10:ℚ)^118)/(6*(1/1600)^2)+
    (1/150)*68*(1/1600)/(18*49^2*(1-4*(1/1600)/49))

theorem momentTwoUpper_bound : momentTwoUpper<1/400000 := by decide +kernel

def momentThirtyTwoRemainder : ℚ :=
  (1/150)*(16/25)^33/(33*576^32*(1-(16/25)/576))
def momentSixteenUpper : ℚ :=
  -16*(∑ j : Fin 33, momentCoefficientWeight j*momentLogSample j)+
    16*momentCoefficientWeightMass*(momentThirtyTwoRemainder+1/(10:ℚ)^118)
