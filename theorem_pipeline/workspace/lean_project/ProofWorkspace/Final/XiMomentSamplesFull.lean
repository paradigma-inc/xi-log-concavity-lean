def ratMomentLogLower (q : ℚ) : ℚ :=
  -ratRoundUpper ((ratLogTaylorScan (q+2/(10:ℚ)^120) 24 (10^160)).2+
    ratLogUniformError (1/500) 24) (10^160)

def ratMomentLogUpper (q : ℚ) : ℚ :=
  -ratRoundLower ((ratLogTaylorScan (q-2/(10:ℚ)^120) 24 (10^160)).1-
    ratLogUniformError (1/500) 24) (10^160)

def ratMomentLogValid (q g : ℚ) : Prop :=
  0<q-2/(10:ℚ)^120 ∧
  |ratLogArgument (q-2/(10:ℚ)^120)|≤1/500 ∧
  |ratLogArgument (q+2/(10:ℚ)^120)|≤1/500 ∧
  g-1/(10:ℚ)^118≤ratMomentLogLower q ∧
  ratMomentLogUpper q≤g+1/(10:ℚ)^118

instance ratMomentLogValid_decidable (q g : ℚ) : Decidable (ratMomentLogValid q g) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _ ∧ _))

theorem ratMomentLogValid_actual (q g : ℚ) (x : ℝ)
    (hv : ratMomentLogValid q g) (hx : |x-(q:ℝ)|≤2/(10:ℝ)^120) :
    |-Real.log x-(g:ℝ)|≤1/(10:ℝ)^118 := by
  obtain ⟨ha,har,hbr,hlo,hhi⟩ := hv
  have hb := abs_le.mp hx
  have he := ratLogFullyRounded_interval_enclosure
    (q-2/(10:ℚ)^120) (q+2/(10:ℚ)^120) (1/500) x 24 (10^160)
    ha (by push_cast; linarith) (by push_cast; linarith)
    (by positivity) har hbr (by norm_num)
  have hl : (g:ℝ)-1/(10:ℝ)^118≤(ratMomentLogLower q:ℝ) := by
    have h := (Rat.cast_le (K:=ℝ)).mpr hlo
    push_cast at h
    exact h
  have hu : (ratMomentLogUpper q:ℝ)≤(g:ℝ)+1/(10:ℝ)^118 := by
    have h := (Rat.cast_le (K:=ℝ)).mpr hhi
    push_cast at h
    exact h
  unfold ratMomentLogLower at hl
  unfold ratMomentLogUpper at hu
  rw [ratLogTaylorScan_upper] at hl
  rw [ratLogTaylorScan_lower] at hu
  change (g:ℝ)-1/(10:ℝ)^118≤
    (-(ratLogFullyRoundedUpper (q+2/(10:ℚ)^120) (1/500) 24 (10^160)):ℚ) at hl
  change ((-(ratLogFullyRoundedLower (q-2/(10:ℚ)^120) (1/500) 24 (10^160)):ℚ):ℝ)≤
    (g:ℝ)+1/(10:ℝ)^118 at hu
  push_cast at hl hu
  exact abs_le.mpr ⟨by linarith [he.1],by linarith [he.2]⟩

