def momentLogSample (j : Fin 33) : ℚ := momentLogSamples.getD j 0

theorem momentLogSamples_valid : ∀ j : Fin 33,
    ratMomentLogValid (sourceFirstMidpoints.getD j 0) (momentLogSample j) := by
  intro j
  fin_cases j
  all_goals decide +kernel

theorem momentLogSample_actual (j : Fin 33) :
    |-Real.log ((reciprocalTransform ((j:ℝ)/40)).re)-(momentLogSample j:ℝ)|≤
      1/(10:ℝ)^118 :=
  ratMomentLogValid_actual _ _ _ (momentLogSamples_valid j)
    (sourceFirstMidpoint_actual_bound j (by omega))

def momentSampleNode (j : Fin 33) : ℚ := (j:ℚ)^2/1600
