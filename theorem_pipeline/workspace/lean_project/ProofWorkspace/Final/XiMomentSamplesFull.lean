]

def momentScaledResidualUpper : ℚ :=
  (60:ℚ)^32*(momentSixteenUpper-
    ∑ j : Fin 3, 1/(momentRootUpperEndpoints.getD j 0)^32)

theorem momentScaledResidualUpper_bound : momentScaledResidualUpper<7/10 := by
  decide +kernel

theorem momentLowResidual_contribution_lower :
    (7/10:ℚ)<(1/9)*(3600/3026)^16 := by decide +kernel

theorem momentHighResidual_contribution_lower :
    (7/10:ℚ)<(1-512/3025)*(3600/3601)^16 := by decide +kernel

