theorem sourceBlock3840PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (3840+k), retainedPiUpper (3840+k)) =
      sourceBlock3840PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 3840, retainedPiUpper 3840) =
      sourceBlock3840PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 3839, retainedPiUpper 3839) :=
      retainedPiPair_succ 3839
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3808PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock3808PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock3840PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock3840PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3840PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 3840 32 sourceBlock3840PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

