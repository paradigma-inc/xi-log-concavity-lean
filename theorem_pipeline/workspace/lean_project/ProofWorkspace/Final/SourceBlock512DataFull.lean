theorem sourceBlock512PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (512+k), retainedPiUpper (512+k)) =
      sourceBlock512PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 512, retainedPiUpper 512) =
      sourceBlock512PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 511, retainedPiUpper 511) :=
      retainedPiPair_succ 511
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock480PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock480PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock512PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock512PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock512PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 512 32 sourceBlock512PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

