theorem sourceBlock12000PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12000+k), retainedPiUpper (12000+k)) =
      sourceBlock12000PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12000, retainedPiUpper 12000) =
      sourceBlock12000PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 11999, retainedPiUpper 11999) :=
      retainedPiPair_succ 11999
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11968PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11968PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12000PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12000PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12000PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12000 32 sourceBlock12000PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

