theorem sourceBlock8256PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8256+k), retainedPiUpper (8256+k)) =
      sourceBlock8256PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8256, retainedPiUpper 8256) =
      sourceBlock8256PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8255, retainedPiUpper 8255) :=
      retainedPiPair_succ 8255
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8224PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8224PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8256PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8256PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8256PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8256 32 sourceBlock8256PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

