    (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) retainedTwoPair_succ 8256 32 sourceBlock8256TwoPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

