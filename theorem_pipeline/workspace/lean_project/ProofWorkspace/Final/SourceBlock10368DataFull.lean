      sourceBlock10368PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10367, retainedPiUpper 10367) :=
      retainedPiPair_succ 10367
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10336PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10336PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10368PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10368PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10368PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10368 32 sourceBlock10368PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

