theorem sourceBlock1920PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (1920+k), retainedPiUpper (1920+k)) =
      sourceBlock1920PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 1920, retainedPiUpper 1920) =
      sourceBlock1920PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 1919, retainedPiUpper 1919) :=
      retainedPiPair_succ 1919
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1888PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock1888PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1920PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1920PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1920PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1920 32 sourceBlock1920PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

