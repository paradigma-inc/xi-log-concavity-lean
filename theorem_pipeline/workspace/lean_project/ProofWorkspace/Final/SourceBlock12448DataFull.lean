theorem sourceBlock12448PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12448+k), retainedPiUpper (12448+k)) =
      sourceBlock12448PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12448, retainedPiUpper 12448) =
      sourceBlock12448PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12447, retainedPiUpper 12447) :=
      retainedPiPair_succ 12447
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12416PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12416PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12448PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12448PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12448PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12448 32 sourceBlock12448PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12448TwoPairs_eq : ∀ k : Fin 32,
    (retainedTwoLower (12448+k), retainedTwoUpper (12448+k)) =
      sourceBlock12448TwoPairs.getD k (0,0) := by
  have hfirst : (retainedTwoLower 12448, retainedTwoUpper 12448) =
      sourceBlock12448TwoPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)
        (retainedTwoLower 12447, retainedTwoUpper 12447) :=
      retainedTwoPair_succ 12447
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12416TwoPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) (sourceBlock12416TwoPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12448TwoPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12448TwoPairs.getD (k+1) (0,0) =
        sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12448TwoPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedTwoLower j, retainedTwoUpper j))
    (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) retainedTwoPair_succ 12448 32 sourceBlock12448TwoPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12448Midpoints_slice_checked :
    sourceBlock12448Midpoints = (sourceMidpointArray.toList.drop 12448).take 32 := by
  decide +kernel

theorem sourceBlock12448Midpoints_eq_array : ∀ k : Fin 32,
    sourceBlock12448Midpoints.getD k 0 = sourceRoundedMidpoint (12448+k) := by
  intro k
  exact sourceMidpointSlice_lookup 12448 32 sourceBlock12448Midpoints
    sourceBlock12448Midpoints_slice_checked k k.isLt

