    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11072PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11072PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11104PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11104PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11104PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11104 32 sourceBlock11104PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

