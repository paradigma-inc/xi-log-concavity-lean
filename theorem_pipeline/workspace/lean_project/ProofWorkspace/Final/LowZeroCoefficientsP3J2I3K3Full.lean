    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP3J2I3K3State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP3J2I3K3Point)
          (theta48PanelCenter 2 3:ℂ) (Real.pi*(3:ℝ)^2)
          (theta48PanelHalfWidth 2) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP3J2I3K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP3J2I3K3Point)
        (Real.pi*(3:ℝ)^2) (((23:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP3J2I3K3State 0):ℝ) := lowZeroCoefficientsP3J2I3K3_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP3J2I3K3Point
    ((23:ℚ)/4) ((1:ℚ)/4) 3 lowZeroCoefficientsP3J2I3K3State lowZeroCoefficientsP3J2I3K3Radius
