  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP4J1I2K5Point
    ((21:ℚ)/8) ((1:ℚ)/8) 5 lowZeroCoefficientsP4J1I2K5State lowZeroCoefficientsP4J1I2K5Radius
