theorem sourceBlock1952PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (1952+k), retainedPiUpper (1952+k)) =
      sourceBlock1952PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 1952, retainedPiUpper 1952) =
      sourceBlock1952PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 1951, retainedPiUpper 1951) :=
      retainedPiPair_succ 1951
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1920PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock1920PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock1952PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock1952PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock1952PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 1952 32 sourceBlock1952PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

