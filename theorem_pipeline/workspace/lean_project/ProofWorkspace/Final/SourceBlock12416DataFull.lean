theorem sourceBlock12416PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12416+k), retainedPiUpper (12416+k)) =
      sourceBlock12416PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12416, retainedPiUpper 12416) =
      sourceBlock12416PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12415, retainedPiUpper 12415) :=
      retainedPiPair_succ 12415
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12384PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12384PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12416PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12416PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12416PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12416 32 sourceBlock12416PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

