theorem sourceBlock8064PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8064+k), retainedPiUpper (8064+k)) =
      sourceBlock8064PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8064, retainedPiUpper 8064) =
      sourceBlock8064PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8063, retainedPiUpper 8063) :=
      retainedPiPair_succ 8063
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8032PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8032PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8064PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8064PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8064PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8064 32 sourceBlock8064PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

