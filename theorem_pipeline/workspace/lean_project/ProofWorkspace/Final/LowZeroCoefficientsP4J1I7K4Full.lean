  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP4J1I7K4Point
    ((31:ℚ)/8) ((1:ℚ)/8) 4 lowZeroCoefficientsP4J1I7K4State lowZeroCoefficientsP4J1I7K4Radius
