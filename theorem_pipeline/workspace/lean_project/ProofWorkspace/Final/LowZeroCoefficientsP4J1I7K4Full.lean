theorem lowZeroCoefficientsP4J1I7K4_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP4J1I7K4Point ((31:ℚ)/8) ((1:ℚ)/8)
      sourcePiMidpoint 4 lowZeroCoefficientsP4J1I7K4State lowZeroCoefficientsP4J1I7K4Radius := by
