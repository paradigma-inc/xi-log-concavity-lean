theorem sourceBlock12160PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12160+k), retainedPiUpper (12160+k)) =
      sourceBlock12160PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12160, retainedPiUpper 12160) =
      sourceBlock12160PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12159, retainedPiUpper 12159) :=
      retainedPiPair_succ 12159
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12128PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12128PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12160PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12160PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12160PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12160 32 sourceBlock12160PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12160TwoPairs_eq : ∀ k : Fin 32,
    (retainedTwoLower (12160+k), retainedTwoUpper (12160+k)) =
      sourceBlock12160TwoPairs.getD k (0,0) := by
  have hfirst : (retainedTwoLower 12160, retainedTwoUpper 12160) =
      sourceBlock12160TwoPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)
        (retainedTwoLower 12159, retainedTwoUpper 12159) :=
      retainedTwoPair_succ 12159
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12128TwoPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) (sourceBlock12128TwoPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12160TwoPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12160TwoPairs.getD (k+1) (0,0) =
        sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12160TwoPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedTwoLower j, retainedTwoUpper j))
    (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) retainedTwoPair_succ 12160 32 sourceBlock12160TwoPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12160Midpoints_slice_checked :
    sourceBlock12160Midpoints = (sourceMidpointArray.toList.drop 12160).take 32 := by
  decide +kernel

theorem sourceBlock12160Midpoints_eq_array : ∀ k : Fin 32,
    sourceBlock12160Midpoints.getD k 0 = sourceRoundedMidpoint (12160+k) := by
  intro k
  exact sourceMidpointSlice_lookup 12160 32 sourceBlock12160Midpoints
    sourceBlock12160Midpoints_slice_checked k k.isLt

