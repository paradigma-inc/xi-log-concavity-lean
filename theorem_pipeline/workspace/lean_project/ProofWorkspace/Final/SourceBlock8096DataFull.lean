theorem sourceBlock8096PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8096+k), retainedPiUpper (8096+k)) =
      sourceBlock8096PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8096, retainedPiUpper 8096) =
      sourceBlock8096PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8095, retainedPiUpper 8095) :=
      retainedPiPair_succ 8095
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8064PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8064PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8096PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8096PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8096PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8096 32 sourceBlock8096PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

