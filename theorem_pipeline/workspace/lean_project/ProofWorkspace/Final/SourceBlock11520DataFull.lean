  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11520 32 sourceBlock11520PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

