    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 7871, retainedPiUpper 7871) :=
      retainedPiPair_succ 7871
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock7840PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock7840PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock7872PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock7872PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock7872PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 7872 32 sourceBlock7872PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

