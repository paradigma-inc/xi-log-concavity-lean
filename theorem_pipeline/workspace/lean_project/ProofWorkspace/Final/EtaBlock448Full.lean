theorem sourceEtaBatch448_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates448 =
      (sourceEtaBatch448Pairs, sourceEtaRootStates480) := by
  decide +kernel

theorem sourceEtaRootStates480_eq : sourceEtaRootStates480 = etaRootStateTable 400 480 := by
  have h := congrArg Prod.snd sourceEtaBatch448_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates448_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch448_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch448Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (448+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (448+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch448_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates448_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 448)).1 =
    sourceEtaBatch448Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 448 32 k hk

def sourceEtaBatch448Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch448Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch448Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch448Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch448_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch448Lower k:ℝ) ≤ etaIntegral (xiGridArgument (448+k):ℝ) ∧
      etaIntegral (xiGridArgument (448+k):ℝ) ≤ (sourceEtaBatch448Upper k:ℝ) := by
  unfold sourceEtaBatch448Lower sourceEtaBatch448Upper
  rw [sourceEtaBatch448_entry k hk]
  exact ratEtaStream_retained_enclosure (448+k)

theorem sourceEtaBatch448_width : ∀ k : Fin 32,
    sourceEtaBatch448Upper k - sourceEtaBatch448Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

