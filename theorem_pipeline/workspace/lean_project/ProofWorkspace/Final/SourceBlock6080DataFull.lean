theorem sourceBlock6080PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (6080+k), retainedPiUpper (6080+k)) =
      sourceBlock6080PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 6080, retainedPiUpper 6080) =
      sourceBlock6080PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 6079, retainedPiUpper 6079) :=
      retainedPiPair_succ 6079
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6048PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock6048PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock6080PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock6080PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock6080PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 6080 32 sourceBlock6080PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

