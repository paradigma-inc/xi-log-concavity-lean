theorem sourceBlock10208PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10208+k), retainedPiUpper (10208+k)) =
      sourceBlock10208PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10208, retainedPiUpper 10208) =
      sourceBlock10208PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10207, retainedPiUpper 10207) :=
      retainedPiPair_succ 10207
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10176PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10176PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10208PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10208PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10208PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10208 32 sourceBlock10208PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

