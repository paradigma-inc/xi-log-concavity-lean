theorem sourceBlock800PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (800+k), retainedPiUpper (800+k)) =
      sourceBlock800PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 800, retainedPiUpper 800) =
      sourceBlock800PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 799, retainedPiUpper 799) :=
      retainedPiPair_succ 799
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock768PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock768PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock800PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock800PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock800PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 800 32 sourceBlock800PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

