      retainedPiPair_succ 8703
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8672PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8672PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8704PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8704PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8704PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8704 32 sourceBlock8704PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

