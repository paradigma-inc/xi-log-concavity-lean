theorem sourceEtaBatch2016_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates2016 =
      (sourceEtaBatch2016Pairs, sourceEtaRootStates2048) := by
  decide +kernel

theorem sourceEtaRootStates2048_eq : sourceEtaRootStates2048 = etaRootStateTable 400 2048 := by
  have h := congrArg Prod.snd sourceEtaBatch2016_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates2016_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch2016_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch2016Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (2016+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (2016+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch2016_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates2016_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 2016)).1 =
    sourceEtaBatch2016Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 2016 32 k hk

def sourceEtaBatch2016Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch2016Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch2016Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch2016Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch2016_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch2016Lower k:ℝ) ≤ etaIntegral (xiGridArgument (2016+k):ℝ) ∧
      etaIntegral (xiGridArgument (2016+k):ℝ) ≤ (sourceEtaBatch2016Upper k:ℝ) := by
  unfold sourceEtaBatch2016Lower sourceEtaBatch2016Upper
  rw [sourceEtaBatch2016_entry k hk]
  exact ratEtaStream_retained_enclosure (2016+k)

theorem sourceEtaBatch2016_width : ∀ k : Fin 32,
    sourceEtaBatch2016Upper k - sourceEtaBatch2016Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
