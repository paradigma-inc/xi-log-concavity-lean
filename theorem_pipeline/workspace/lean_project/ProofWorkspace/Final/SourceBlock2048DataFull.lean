theorem sourceBlock2048PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (2048+k), retainedPiUpper (2048+k)) =
      sourceBlock2048PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 2048, retainedPiUpper 2048) =
      sourceBlock2048PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 2047, retainedPiUpper 2047) :=
      retainedPiPair_succ 2047
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock2016PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock2016PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock2048PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock2048PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock2048PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 2048 32 sourceBlock2048PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

