theorem sourceBlock9632PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (9632+k), retainedPiUpper (9632+k)) =
      sourceBlock9632PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 9632, retainedPiUpper 9632) =
      sourceBlock9632PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 9631, retainedPiUpper 9631) :=
      retainedPiPair_succ 9631
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock9600PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock9600PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock9632PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock9632PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock9632PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 9632 32 sourceBlock9632PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

