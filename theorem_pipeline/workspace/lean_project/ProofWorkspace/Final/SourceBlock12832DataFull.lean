theorem sourceBlock12832PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12832+k), retainedPiUpper (12832+k)) =
      sourceBlock12832PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12832, retainedPiUpper 12832) =
      sourceBlock12832PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12831, retainedPiUpper 12831) :=
      retainedPiPair_succ 12831
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12800PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12800PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12832PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12832PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12832PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12832 32 sourceBlock12832PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12832TwoPairs_eq : ∀ k : Fin 32,
    (retainedTwoLower (12832+k), retainedTwoUpper (12832+k)) =
      sourceBlock12832TwoPairs.getD k (0,0) := by
  have hfirst : (retainedTwoLower 12832, retainedTwoUpper 12832) =
      sourceBlock12832TwoPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)
        (retainedTwoLower 12831, retainedTwoUpper 12831) :=
      retainedTwoPair_succ 12831
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12800TwoPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) (sourceBlock12800TwoPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12832TwoPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12832TwoPairs.getD (k+1) (0,0) =
        sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12832TwoPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedTwoLower j, retainedTwoUpper j))
    (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) retainedTwoPair_succ 12832 32 sourceBlock12832TwoPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12832Midpoints_slice_checked :
    sourceBlock12832Midpoints = (sourceMidpointArray.toList.drop 12832).take 32 := by
  decide +kernel

theorem sourceBlock12832Midpoints_eq_array : ∀ k : Fin 32,
    sourceBlock12832Midpoints.getD k 0 = sourceRoundedMidpoint (12832+k) := by
  intro k
  exact sourceMidpointSlice_lookup 12832 32 sourceBlock12832Midpoints
    sourceBlock12832Midpoints_slice_checked k k.isLt

