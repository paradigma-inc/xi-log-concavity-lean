def lowZeroCoefficientsP4J2I5K3State (n : ℕ) : ℚ × ℚ := lowZeroCoefficientsP4J2I5K3States.getD n (0,0)
def lowZeroCoefficientsP4J2I5K3Radius (n : ℕ) : ℚ := lowZeroCoefficientsP4J2I5K3Radii.getD n 0

theorem lowZeroCoefficientsP4J2I5K3_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP4J2I5K3Point ((27:ℚ)/4) ((1:ℚ)/4)
      sourcePiMidpoint 3 lowZeroCoefficientsP4J2I5K3State lowZeroCoefficientsP4J2I5K3Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP4J2I5K3_seed_eq : lowZeroCoefficientsP4J2I5K3State 0=lowZeroSeedP4J2I5K3State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP4J2I5K3_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP4J2I5K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J2I5K3Point)
        (Real.pi*(3:ℝ)^2) (((27:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J2I5K3State 0):ℝ) := by
  rw [lowZeroCoefficientsP4J2I5K3_seed_eq]
  have he := lowZeroSeedP4J2I5K3_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP4J2I5K3State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP4J2I5K3_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP4J2I5K3State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP4J2I5K3Point)
          (theta48PanelCenter 2 5:ℂ) (Real.pi*(3:ℝ)^2)
          (theta48PanelHalfWidth 2) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP4J2I5K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J2I5K3Point)
        (Real.pi*(3:ℝ)^2) (((27:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J2I5K3State 0):ℝ) := lowZeroCoefficientsP4J2I5K3_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP4J2I5K3Point
    ((27:ℚ)/4) ((1:ℚ)/4) 3 lowZeroCoefficientsP4J2I5K3State lowZeroCoefficientsP4J2I5K3Radius
    lowZeroCoefficientsP4J2I5K3_valid (by convert hs using 1 <;> norm_num)
