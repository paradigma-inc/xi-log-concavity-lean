    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11328PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11328PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11360PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11360PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11360PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11360 32 sourceBlock11360PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

