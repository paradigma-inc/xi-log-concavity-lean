theorem sourceBlock12512PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12512+k), retainedPiUpper (12512+k)) =
      sourceBlock12512PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12512, retainedPiUpper 12512) =
      sourceBlock12512PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12511, retainedPiUpper 12511) :=
      retainedPiPair_succ 12511
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12480PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12480PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12512PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12512PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12512PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12512 32 sourceBlock12512PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

