    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 11679, retainedPiUpper 11679) :=
      retainedPiPair_succ 11679
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11648PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock11648PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock11680PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock11680PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock11680PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 11680 32 sourceBlock11680PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

