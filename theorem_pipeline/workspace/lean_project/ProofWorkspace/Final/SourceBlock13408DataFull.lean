    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 13407, retainedPiUpper 13407) :=
      retainedPiPair_succ 13407
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13376PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock13376PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock13408PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock13408PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13408PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 13408 32 sourceBlock13408PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

