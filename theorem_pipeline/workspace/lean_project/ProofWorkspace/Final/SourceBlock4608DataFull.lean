theorem sourceBlock4608PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (4608+k), retainedPiUpper (4608+k)) =
      sourceBlock4608PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 4608, retainedPiUpper 4608) =
      sourceBlock4608PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 4607, retainedPiUpper 4607) :=
      retainedPiPair_succ 4607
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4576PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock4576PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock4608PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock4608PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock4608PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 4608 32 sourceBlock4608PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

