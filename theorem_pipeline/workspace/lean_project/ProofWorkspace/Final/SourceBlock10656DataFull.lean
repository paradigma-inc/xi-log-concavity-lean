theorem sourceBlock10656PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10656+k), retainedPiUpper (10656+k)) =
      sourceBlock10656PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10656, retainedPiUpper 10656) =
      sourceBlock10656PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10655, retainedPiUpper 10655) :=
      retainedPiPair_succ 10655
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10624PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10624PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10656PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10656PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10656PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10656 32 sourceBlock10656PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

