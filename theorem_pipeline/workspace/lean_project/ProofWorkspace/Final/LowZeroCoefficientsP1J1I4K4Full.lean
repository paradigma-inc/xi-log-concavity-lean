    ratLowZeroCoefficientsValid lowZeroSeedP1J1I4K4Point ((25:ℚ)/8) ((1:ℚ)/8)
      sourcePiMidpoint 4 lowZeroCoefficientsP1J1I4K4State lowZeroCoefficientsP1J1I4K4Radius := by
