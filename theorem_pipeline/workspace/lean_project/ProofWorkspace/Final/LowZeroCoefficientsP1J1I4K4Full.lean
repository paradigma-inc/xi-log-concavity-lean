    ‖ratComplexValue (lowZeroCoefficientsP1J1I4K4State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP1J1I4K4Point)
        (Real.pi*(4:ℝ)^2) (((25:ℚ)/8):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP1J1I4K4State 0):ℝ) := by
  rw [lowZeroCoefficientsP1J1I4K4_seed_eq]
  have he := lowZeroSeedP1J1I4K4_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP1J1I4K4State 16))
