    (sourceEtaBatch32Lower k:ℝ) ≤ etaIntegral (xiGridArgument (32+k):ℝ) ∧
      etaIntegral (xiGridArgument (32+k):ℝ) ≤ (sourceEtaBatch32Upper k:ℝ) := by
  unfold sourceEtaBatch32Lower sourceEtaBatch32Upper
  rw [sourceEtaBatch32_entry k hk]
  exact ratEtaStream_retained_enclosure (32+k)

theorem sourceEtaBatch32_width : ∀ k : Fin 32,
    sourceEtaBatch32Upper k - sourceEtaBatch32Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi

