theorem sourceEtaBatch4224_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates4224 =
      (sourceEtaBatch4224Pairs, sourceEtaRootStates4256) := by
  decide +kernel

theorem sourceEtaRootStates4256_eq : sourceEtaRootStates4256 = etaRootStateTable 400 4256 := by
  have h := congrArg Prod.snd sourceEtaBatch4224_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4224_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch4224_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch4224Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4224+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (4224+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch4224_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates4224_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 4224)).1 =
    sourceEtaBatch4224Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 4224 32 k hk

def sourceEtaBatch4224Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch4224Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch4224Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch4224Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch4224_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch4224Lower k:ℝ) ≤ etaIntegral (xiGridArgument (4224+k):ℝ) ∧
      etaIntegral (xiGridArgument (4224+k):ℝ) ≤ (sourceEtaBatch4224Upper k:ℝ) := by
  unfold sourceEtaBatch4224Lower sourceEtaBatch4224Upper
  rw [sourceEtaBatch4224_entry k hk]
  exact ratEtaStream_retained_enclosure (4224+k)

theorem sourceEtaBatch4224_width : ∀ k : Fin 32,
    sourceEtaBatch4224Upper k - sourceEtaBatch4224Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

