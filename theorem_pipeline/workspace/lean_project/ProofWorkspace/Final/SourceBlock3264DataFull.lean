theorem sourceBlock3264PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (3264+k), retainedPiUpper (3264+k)) =
      sourceBlock3264PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 3264, retainedPiUpper 3264) =
      sourceBlock3264PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 3263, retainedPiUpper 3263) :=
      retainedPiPair_succ 3263
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3232PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock3232PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock3264PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock3264PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock3264PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 3264 32 sourceBlock3264PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

