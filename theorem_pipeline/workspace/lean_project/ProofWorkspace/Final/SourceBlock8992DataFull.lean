theorem sourceBlock8992PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (8992+k), retainedPiUpper (8992+k)) =
      sourceBlock8992PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 8992, retainedPiUpper 8992) =
      sourceBlock8992PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 8991, retainedPiUpper 8991) :=
      retainedPiPair_succ 8991
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8960PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8960PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8992PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8992PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8992PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8992 32 sourceBlock8992PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

