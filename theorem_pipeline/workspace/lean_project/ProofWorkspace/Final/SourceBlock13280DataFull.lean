theorem sourceBlock13280PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (13280+k), retainedPiUpper (13280+k)) =
      sourceBlock13280PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 13280, retainedPiUpper 13280) =
      sourceBlock13280PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 13279, retainedPiUpper 13279) :=
      retainedPiPair_succ 13279
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13248PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock13248PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock13280PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock13280PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13280PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 13280 32 sourceBlock13280PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

