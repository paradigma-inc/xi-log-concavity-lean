  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 2080)).1 =
    sourceEtaBatch2080Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 2080 32 k hk

def sourceEtaBatch2080Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch2080Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch2080Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch2080Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch2080_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch2080Lower k:ℝ) ≤ etaIntegral (xiGridArgument (2080+k):ℝ) ∧
      etaIntegral (xiGridArgument (2080+k):ℝ) ≤ (sourceEtaBatch2080Upper k:ℝ) := by
  unfold sourceEtaBatch2080Lower sourceEtaBatch2080Upper
  rw [sourceEtaBatch2080_entry k hk]
  exact ratEtaStream_retained_enclosure (2080+k)

theorem sourceEtaBatch2080_width : ∀ k : Fin 32,
    sourceEtaBatch2080Upper k - sourceEtaBatch2080Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
