      sourceBlock12064PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12064, retainedPiUpper 12064) =
      sourceBlock12064PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12063, retainedPiUpper 12063) :=
      retainedPiPair_succ 12063
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12032PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12032PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12064PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12064PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12064PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12064 32 sourceBlock12064PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

