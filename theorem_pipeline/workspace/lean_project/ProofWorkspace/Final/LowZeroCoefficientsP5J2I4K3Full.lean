def lowZeroCoefficientsP5J2I4K3Radius (n : ℕ) : ℚ := lowZeroCoefficientsP5J2I4K3Radii.getD n 0

theorem lowZeroCoefficientsP5J2I4K3_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP5J2I4K3Point ((25:ℚ)/4) ((1:ℚ)/4)
      sourcePiMidpoint 3 lowZeroCoefficientsP5J2I4K3State lowZeroCoefficientsP5J2I4K3Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP5J2I4K3_seed_eq : lowZeroCoefficientsP5J2I4K3State 0=lowZeroSeedP5J2I4K3State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP5J2I4K3_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP5J2I4K3State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP5J2I4K3Point)
        (Real.pi*(3:ℝ)^2) (((25:ℚ)/4):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP5J2I4K3State 0):ℝ) := by
  rw [lowZeroCoefficientsP5J2I4K3_seed_eq]
  have he := lowZeroSeedP5J2I4K3_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP5J2I4K3State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

