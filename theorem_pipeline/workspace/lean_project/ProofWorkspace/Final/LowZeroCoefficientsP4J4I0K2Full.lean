def lowZeroCoefficientsP4J4I0K2State (n : ℕ) : ℚ × ℚ := lowZeroCoefficientsP4J4I0K2States.getD n (0,0)
def lowZeroCoefficientsP4J4I0K2Radius (n : ℕ) : ℚ := lowZeroCoefficientsP4J4I0K2Radii.getD n 0

theorem lowZeroCoefficientsP4J4I0K2_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP4J4I0K2Point ((17:ℚ)/1) ((1:ℚ)/1)
      sourcePiMidpoint 2 lowZeroCoefficientsP4J4I0K2State lowZeroCoefficientsP4J4I0K2Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP4J4I0K2_seed_eq : lowZeroCoefficientsP4J4I0K2State 0=lowZeroSeedP4J4I0K2State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP4J4I0K2_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP4J4I0K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J4I0K2Point)
        (Real.pi*(2:ℝ)^2) (((17:ℚ)/1):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J4I0K2State 0):ℝ) := by
  rw [lowZeroCoefficientsP4J4I0K2_seed_eq]
  have he := lowZeroSeedP4J4I0K2_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP4J4I0K2State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP4J4I0K2_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP4J4I0K2State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP4J4I0K2Point)
          (theta48PanelCenter 4 0:ℂ) (Real.pi*(2:ℝ)^2)
          (theta48PanelHalfWidth 4) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP4J4I0K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J4I0K2Point)
        (Real.pi*(2:ℝ)^2) (((17:ℚ)/1):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J4I0K2State 0):ℝ) := lowZeroCoefficientsP4J4I0K2_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP4J4I0K2Point
    ((17:ℚ)/1) ((1:ℚ)/1) 2 lowZeroCoefficientsP4J4I0K2State lowZeroCoefficientsP4J4I0K2Radius
    lowZeroCoefficientsP4J4I0K2_valid (by convert hs using 1 <;> norm_num)
  convert he using 1 <;> norm_num [theta48PanelCenter,theta48PanelHalfWidth]

