    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock352PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock352PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock384PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock384PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock384PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 384 32 sourceBlock384PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

