      etaIntegral (xiGridArgument (2112+k):ℝ) ≤ (sourceEtaBatch2112Upper k:ℝ) := by
  unfold sourceEtaBatch2112Lower sourceEtaBatch2112Upper
  rw [sourceEtaBatch2112_entry k hk]
  exact ratEtaStream_retained_enclosure (2112+k)

theorem sourceEtaBatch2112_width : ∀ k : Fin 32,
    sourceEtaBatch2112Upper k - sourceEtaBatch2112Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
