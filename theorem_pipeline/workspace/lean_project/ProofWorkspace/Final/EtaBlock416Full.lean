theorem sourceEtaBatch416_checked :
    etaStreamBatch sourceEtaSignedWeights 32 sourceEtaRootStates416 =
      (sourceEtaBatch416Pairs, sourceEtaRootStates448) := by
  decide +kernel

theorem sourceEtaRootStates448_eq : sourceEtaRootStates448 = etaRootStateTable 400 448 := by
  have h := congrArg Prod.snd sourceEtaBatch416_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates416_eq,
    etaStreamBatch_final_canonical] at h
  exact h.symm

theorem sourceEtaBatch416_entry (k : ℕ) (hk : k < 32) :
    sourceEtaBatch416Pairs.getD k (0,0) =
      (etaStreamLowerSum (etaSignedWeightTable 400) (etaRootStateTable 400 (416+k)),
        etaStreamUpperSum (etaSignedWeightTable 400) (etaRootStateTable 400 (416+k))) := by
  have h := congrArg Prod.fst sourceEtaBatch416_checked
  rw [sourceEtaSignedWeights_eq, sourceEtaRootStates416_eq] at h
  change (etaStreamBatch (etaSignedWeightTable 400) 32 (etaRootStateTable 400 416)).1 =
    sourceEtaBatch416Pairs at h
  rw [←h, List.getD_eq_getElem _ _ (by rw [etaStreamBatch_length]; exact hk)]
  exact etaStreamBatch_getElem 400 416 32 k hk

def sourceEtaBatch416Lower (k : ℕ) : ℚ :=
  ratRoundLower (((sourceEtaBatch416Pairs.getD k (0,0)).1:ℚ)/rootCertificateScale)
    rootCertificateScale
def sourceEtaBatch416Upper (k : ℕ) : ℚ :=
  ratRoundUpper (((sourceEtaBatch416Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch416_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch416Lower k:ℝ) ≤ etaIntegral (xiGridArgument (416+k):ℝ) ∧
      etaIntegral (xiGridArgument (416+k):ℝ) ≤ (sourceEtaBatch416Upper k:ℝ) := by
  unfold sourceEtaBatch416Lower sourceEtaBatch416Upper
  rw [sourceEtaBatch416_entry k hk]
  exact ratEtaStream_retained_enclosure (416+k)

theorem sourceEtaBatch416_width : ∀ k : Fin 32,
    sourceEtaBatch416Upper k - sourceEtaBatch416Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

