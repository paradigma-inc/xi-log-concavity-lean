def lowZeroCoefficientsP4J1I4K4State (n : ℕ) : ℚ × ℚ := lowZeroCoefficientsP4J1I4K4States.getD n (0,0)
def lowZeroCoefficientsP4J1I4K4Radius (n : ℕ) : ℚ := lowZeroCoefficientsP4J1I4K4Radii.getD n 0

theorem lowZeroCoefficientsP4J1I4K4_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP4J1I4K4Point ((25:ℚ)/8) ((1:ℚ)/8)
      sourcePiMidpoint 4 lowZeroCoefficientsP4J1I4K4State lowZeroCoefficientsP4J1I4K4Radius := by
  unfold ratLowZeroCoefficientsValid
  decide +kernel

theorem lowZeroCoefficientsP4J1I4K4_seed_eq : lowZeroCoefficientsP4J1I4K4State 0=lowZeroSeedP4J1I4K4State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP4J1I4K4_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP4J1I4K4State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J1I4K4Point)
        (Real.pi*(4:ℝ)^2) (((25:ℚ)/8):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J1I4K4State 0):ℝ) := by
  rw [lowZeroCoefficientsP4J1I4K4_seed_eq]
  have he := lowZeroSeedP4J1I4K4_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP4J1I4K4State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

theorem lowZeroCoefficientsP4J1I4K4_actual_coefficient_error :
    ∀ n, n<80 →
      ‖ratComplexValue (lowZeroCoefficientsP4J1I4K4State n)-
        scaledPowerExpCoefficient (complexThetaExponent lowZeroSeedP4J1I4K4Point)
          (theta48PanelCenter 1 4:ℂ) (Real.pi*(4:ℝ)^2)
          (theta48PanelHalfWidth 1) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP4J1I4K4State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J1I4K4Point)
        (Real.pi*(4:ℝ)^2) (((25:ℚ)/8):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J1I4K4State 0):ℝ) := lowZeroCoefficientsP4J1I4K4_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP4J1I4K4Point
    ((25:ℚ)/8) ((1:ℚ)/8) 4 lowZeroCoefficientsP4J1I4K4State lowZeroCoefficientsP4J1I4K4Radius
    lowZeroCoefficientsP4J1I4K4_valid (by convert hs using 1 <;> norm_num)
  convert he using 1 <;> norm_num [theta48PanelCenter,theta48PanelHalfWidth]

