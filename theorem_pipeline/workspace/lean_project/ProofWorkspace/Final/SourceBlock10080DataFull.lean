theorem sourceBlock10080PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10080+k), retainedPiUpper (10080+k)) =
      sourceBlock10080PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10080, retainedPiUpper 10080) =
      sourceBlock10080PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10079, retainedPiUpper 10079) :=
      retainedPiPair_succ 10079
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10048PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10048PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10080PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10080PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10080PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10080 32 sourceBlock10080PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

