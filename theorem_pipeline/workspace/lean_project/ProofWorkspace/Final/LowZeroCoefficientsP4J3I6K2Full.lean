          (theta48PanelHalfWidth 3) n‖≤1/(10:ℝ)^50 := by
  have hs : ‖ratComplexValue (lowZeroCoefficientsP4J3I6K2State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J3I6K2Point)
        (Real.pi*(2:ℝ)^2) (((29:ℚ)/2):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J3I6K2State 0):ℝ) := lowZeroCoefficientsP4J3I6K2_seed_error
  have he := ratLowZeroCoefficientsValid_uniform_error lowZeroSeedP4J3I6K2Point
    ((29:ℚ)/2) ((1:ℚ)/2) 2 lowZeroCoefficientsP4J3I6K2State lowZeroCoefficientsP4J3I6K2Radius
