theorem lowZeroCoefficientsP2J1I5K4_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP2J1I5K4Point ((27:ℚ)/8) ((1:ℚ)/8)
      sourcePiMidpoint 4 lowZeroCoefficientsP2J1I5K4State lowZeroCoefficientsP2J1I5K4Radius := by
