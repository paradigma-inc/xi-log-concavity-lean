theorem lowZeroCoefficientsP2J1I5K4_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP2J1I5K4State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP2J1I5K4Point)
        (Real.pi*(4:ℝ)^2) (((27:ℚ)/8):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP2J1I5K4State 0):ℝ) := by
  rw [lowZeroCoefficientsP2J1I5K4_seed_eq]
  have he := lowZeroSeedP2J1I5K4_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP2J1I5K4State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

