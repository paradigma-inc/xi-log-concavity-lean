theorem sourceBlock13440PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (13440+k), retainedPiUpper (13440+k)) =
      sourceBlock13440PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 13440, retainedPiUpper 13440) =
      sourceBlock13440PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 13439, retainedPiUpper 13439) :=
      retainedPiPair_succ 13439
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13408PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock13408PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock13440PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock13440PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock13440PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 13440 32 sourceBlock13440PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

