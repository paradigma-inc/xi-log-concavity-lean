theorem sourceBlock12384PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (12384+k), retainedPiUpper (12384+k)) =
      sourceBlock12384PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 12384, retainedPiUpper 12384) =
      sourceBlock12384PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12383, retainedPiUpper 12383) :=
      retainedPiPair_succ 12383
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12352PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12352PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12384PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12384PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12384PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12384 32 sourceBlock12384PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12384TwoPairs_eq : ∀ k : Fin 32,
    (retainedTwoLower (12384+k), retainedTwoUpper (12384+k)) =
      sourceBlock12384TwoPairs.getD k (0,0) := by
  have hfirst : (retainedTwoLower 12384, retainedTwoUpper 12384) =
      sourceBlock12384TwoPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)
        (retainedTwoLower 12383, retainedTwoUpper 12383) :=
      retainedTwoPair_succ 12383
    _ = sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12352TwoPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) (sourceBlock12352TwoPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12384TwoPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12384TwoPairs.getD (k+1) (0,0) =
        sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2) (sourceBlock12384TwoPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedTwoLower j, retainedTwoUpper j))
    (sourcePowerPairStep (rootLowerFor 2) (rootUpperFor 2)) retainedTwoPair_succ 12384 32 sourceBlock12384TwoPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

theorem sourceBlock12384Midpoints_slice_checked :
    sourceBlock12384Midpoints = (sourceMidpointArray.toList.drop 12384).take 32 := by
  decide +kernel

theorem sourceBlock12384Midpoints_eq_array : ∀ k : Fin 32,
    sourceBlock12384Midpoints.getD k 0 = sourceRoundedMidpoint (12384+k) := by
  intro k
  exact sourceMidpointSlice_lookup 12384 32 sourceBlock12384Midpoints
    sourceBlock12384Midpoints_slice_checked k k.isLt

