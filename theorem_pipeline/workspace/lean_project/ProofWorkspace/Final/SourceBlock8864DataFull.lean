      retainedPiPair_succ 8863
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8832PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock8832PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock8864PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock8864PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock8864PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 8864 32 sourceBlock8864PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

