theorem sourceBlock10400PiPairs_eq : ∀ k : Fin 32,
    (retainedPiLower (10400+k), retainedPiUpper (10400+k)) =
      sourceBlock10400PiPairs.getD k (0,0) := by
  have hfirst : (retainedPiLower 10400, retainedPiUpper 10400) =
      sourceBlock10400PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 10399, retainedPiUpper 10399) :=
      retainedPiPair_succ 10399
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10368PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock10368PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock10400PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock10400PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock10400PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 10400 32 sourceBlock10400PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

