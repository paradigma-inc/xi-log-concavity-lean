      sourceBlock12320PiPairs.getD 0 (0,0) := calc
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper
        (retainedPiLower 12319, retainedPiUpper 12319) :=
      retainedPiPair_succ 12319
    _ = sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12288PiPairs.getD 31 (0,0)) :=
      congrArg (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) (sourceBlock12288PiPairs_eq ⟨31, by decide⟩)
    _ = sourceBlock12320PiPairs.getD 0 (0,0) := by decide +kernel
  have hnext : ∀ k : Fin 31,
      sourceBlock12320PiPairs.getD (k+1) (0,0) =
        sourcePowerPairStep sourcePiRootLower sourcePiRootUpper (sourceBlock12320PiPairs.getD k (0,0)) := by
    decide +kernel
  intro k
  exact sourcePowerTable_sound
    (fun j => (retainedPiLower j, retainedPiUpper j))
    (sourcePowerPairStep sourcePiRootLower sourcePiRootUpper) retainedPiPair_succ 12320 32 sourceBlock12320PiPairs
    hfirst (fun j hj => hnext ⟨j, by omega⟩) k k.isLt

