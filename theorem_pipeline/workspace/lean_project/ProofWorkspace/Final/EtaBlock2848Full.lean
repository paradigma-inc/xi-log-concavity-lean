  ratRoundUpper (((sourceEtaBatch2848Pairs.getD k (0,0)).2:ℚ)/rootCertificateScale+1/2^400)
    rootCertificateScale

theorem sourceEtaBatch2848_actual_enclosure (k : ℕ) (hk : k < 32) :
    (sourceEtaBatch2848Lower k:ℝ) ≤ etaIntegral (xiGridArgument (2848+k):ℝ) ∧
      etaIntegral (xiGridArgument (2848+k):ℝ) ≤ (sourceEtaBatch2848Upper k:ℝ) := by
  unfold sourceEtaBatch2848Lower sourceEtaBatch2848Upper
  rw [sourceEtaBatch2848_entry k hk]
  exact ratEtaStream_retained_enclosure (2848+k)

theorem sourceEtaBatch2848_width : ∀ k : Fin 32,
    sourceEtaBatch2848Upper k - sourceEtaBatch2848Lower k < 1/(10:ℚ)^120 := by
  decide +kernel

end ReciprocalXi
