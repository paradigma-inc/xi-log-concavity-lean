  decide +kernel

theorem lowZeroCoefficientsP4J1I6K4_seed_eq : lowZeroCoefficientsP4J1I6K4State 0=lowZeroSeedP4J1I6K4State 16 := by
  decide +kernel

theorem lowZeroCoefficientsP4J1I6K4_seed_error :
    ‖ratComplexValue (lowZeroCoefficientsP4J1I6K4State 0)-
      complexPowerExpAtom (complexThetaExponent lowZeroSeedP4J1I6K4Point)
        (Real.pi*(4:ℝ)^2) (((29:ℚ)/8):ℂ)‖≤
      (lowZeroSeedRadius (lowZeroCoefficientsP4J1I6K4State 0):ℝ) := by
  rw [lowZeroCoefficientsP4J1I6K4_seed_eq]
  have he := lowZeroSeedP4J1I6K4_actual_atom_error
  have hb := he.trans (lowZeroSeedRadius_sound (lowZeroSeedP4J1I6K4State 16))
  convert hb using 1 <;> norm_num [theta48PanelCenter]

