theorem lowZeroCoefficientsP4J1I6K4_valid :
    ratLowZeroCoefficientsValid lowZeroSeedP4J1I6K4Point ((29:ℚ)/8) ((1:ℚ)/8)
      sourcePiMidpoint 4 lowZeroCoefficientsP4J1I6K4State lowZeroCoefficientsP4J1I6K4Radius := by
